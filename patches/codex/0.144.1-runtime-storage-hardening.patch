diff --git a/codex-rs/rollout/src/runtime_storage_compression_tests.rs b/codex-rs/rollout/src/runtime_storage_compression_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..894617d922892c0c0615d1eedf067bc31dfdd5a9
--- /dev/null
+++ b/codex-rs/rollout/src/runtime_storage_compression_tests.rs
@@ -0,0 +1,193 @@
+use std::fs::FileTimes;
+use std::io::Write;
+use std::time::Duration;
+use std::time::SystemTime;
+
+use pretty_assertions::assert_eq;
+use tempfile::TempDir;
+use uuid::Uuid;
+
+use super::*;
+use crate::StateDbHandle;
+
+fn synthetic_archived_rollout(home: &Path, thread_id: Uuid) -> PathBuf {
+    let directory = home.join("archived_sessions/2026/07/17");
+    std::fs::create_dir_all(&directory).expect("archive directory");
+    let path = directory.join(format!("rollout-2026-07-17T12-00-00-{thread_id}.jsonl"));
+    let bytes = format!(
+        "{{\"timestamp\":\"2026-07-17T12:00:00Z\",\"type\":\"session_meta\",\"payload\":{{\"id\":\"{thread_id}\",\"cwd\":\"/synthetic/project\",\"timestamp\":\"2026-07-17T12:00:00Z\"}}}}\n{{\"type\":\"event_msg\",\"payload\":{{\"type\":\"task_complete\",\"message\":\"synthetic-only\"}}}}\n"
+    );
+    std::fs::write(&path, bytes).expect("synthetic rollout");
+    let old = SystemTime::now() - Duration::from_secs(60 * 60);
+    std::fs::File::options()
+        .write(true)
+        .open(&path)
+        .expect("open rollout")
+        .set_times(FileTimes::new().set_modified(old))
+        .expect("old mtime");
+    path
+}
+
+async fn state(home: &Path) -> StateDbHandle {
+    codex_state::StateRuntime::init(home.to_path_buf(), "synthetic".to_string())
+        .await
+        .expect("synthetic state")
+}
+
+#[tokio::test]
+async fn archived_rollout_is_cataloged_verified_and_restorable_exactly() -> anyhow::Result<()> {
+    let home = TempDir::new()?;
+    let thread_id = Uuid::now_v7();
+    let raw = synthetic_archived_rollout(home.path(), thread_id);
+    let expected = std::fs::read(&raw)?;
+    let runtime = state(home.path()).await;
+
+    worker::run_once(home.path(), &runtime).await?;
+
+    let compressed = compressed_rollout_path(&raw);
+    let manifest_path = crate::manifest::manifest_path(&compressed);
+    assert!(
+        raw.exists(),
+        "plain source remains throughout the grace window"
+    );
+    assert!(compressed.exists());
+    assert!(manifest_path.exists());
+    let manifest = crate::manifest::read_manifest(&manifest_path)?;
+    crate::manifest::verify_installed_representation(&manifest, &compressed)?;
+    assert_eq!(manifest.raw_bytes, expected.len() as u64);
+    assert_eq!(
+        runtime
+            .runtime_storage_manifest(&thread_id.to_string())
+            .await?,
+        Some(manifest.to_state_record(&manifest_path)?)
+    );
+
+    std::fs::remove_file(&raw)?;
+    let restored = materialize_rollout_for_append(&raw).await?;
+    assert_eq!(std::fs::read(&restored)?, expected);
+    assert!(!compressed.exists());
+    assert!(!manifest_path.exists());
+    Ok(())
+}
+
+#[test]
+fn plain_retirement_requires_the_full_grace_window() -> anyhow::Result<()> {
+    let home = TempDir::new()?;
+    let raw = synthetic_archived_rollout(home.path(), Uuid::now_v7());
+    let compressed = compress_for_manifest(&raw)?;
+    let manifest = crate::manifest::build_verified_manifest(&raw, &compressed, 3)?;
+    let installed =
+        SystemTime::UNIX_EPOCH + Duration::from_secs(u64::try_from(manifest.installed_at)?);
+    assert!(!worker::retirement_grace_elapsed(
+        &manifest,
+        installed + Duration::from_secs(24 * 60 * 60 - 1)
+    )?);
+    assert!(worker::retirement_grace_elapsed(
+        &manifest,
+        installed + Duration::from_secs(24 * 60 * 60)
+    )?);
+    Ok(())
+}
+
+fn compress_for_manifest(raw: &Path) -> anyhow::Result<PathBuf> {
+    let compressed = compressed_rollout_path(raw);
+    let output = std::fs::File::create(&compressed)?;
+    let mut encoder = zstd::stream::write::Encoder::new(output, 3)?;
+    encoder.include_checksum(true)?;
+    encoder.write_all(&std::fs::read(raw)?)?;
+    encoder.finish()?.sync_all()?;
+    Ok(compressed)
+}
+
+#[tokio::test]
+async fn per_thread_lease_refuses_competing_compressor_and_append_writer() -> anyhow::Result<()> {
+    let home = TempDir::new()?;
+    let thread_id = Uuid::now_v7();
+    let raw = synthetic_archived_rollout(home.path(), thread_id);
+    let runtime = state(home.path()).await;
+    let lease = RolloutLease::acquire_for_path(&raw)?;
+
+    worker::run_once(home.path(), &runtime).await?;
+    assert!(raw.exists());
+    assert!(!compressed_rollout_path(&raw).exists());
+
+    drop(lease);
+    worker::run_once(home.path(), &runtime).await?;
+    let restored = materialize_rollout_for_append_blocking(&raw)?;
+    let mut writer = std::fs::OpenOptions::new().append(true).open(&restored)?;
+    writer.write_all(b"{\"type\":\"event_msg\",\"payload\":{\"type\":\"synthetic_append\"}}\n")?;
+    writer.sync_all()?;
+    assert!(std::fs::read_to_string(&restored)?.contains("synthetic_append"));
+    Ok(())
+}
+
+#[tokio::test]
+async fn deterministic_zstd_and_pins_are_enforced() -> anyhow::Result<()> {
+    let first_home = TempDir::new()?;
+    let second_home = TempDir::new()?;
+    let thread_id = Uuid::now_v7();
+    let first = synthetic_archived_rollout(first_home.path(), thread_id);
+    let second = synthetic_archived_rollout(second_home.path(), thread_id);
+    std::fs::write(
+        first.with_file_name(format!(
+            "{}.pin",
+            first.file_name().unwrap().to_string_lossy()
+        )),
+        b"synthetic pin",
+    )?;
+
+    worker::run_once(first_home.path(), &state(first_home.path()).await).await?;
+    assert!(first.exists());
+    assert!(!compressed_rollout_path(&first).exists());
+
+    std::fs::remove_file(first.with_file_name(format!(
+        "{}.pin",
+        first.file_name().unwrap().to_string_lossy()
+    )))?;
+    worker::run_once(first_home.path(), &state(first_home.path()).await).await?;
+    worker::run_once(second_home.path(), &state(second_home.path()).await).await?;
+    assert_eq!(
+        std::fs::read(compressed_rollout_path(&first))?,
+        std::fs::read(compressed_rollout_path(&second))?
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn unknown_format_and_ambiguous_dual_representation_fail_closed() -> anyhow::Result<()> {
+    let home = TempDir::new()?;
+    let thread_id = Uuid::now_v7();
+    let raw = synthetic_archived_rollout(home.path(), thread_id);
+    std::fs::write(&raw, b"not-session-meta\n")?;
+    let runtime = state(home.path()).await;
+    worker::run_once(home.path(), &runtime).await?;
+    assert!(raw.exists());
+
+    std::fs::remove_file(&raw)?;
+    let raw = synthetic_archived_rollout(home.path(), thread_id);
+    worker::run_once(home.path(), &runtime).await?;
+    let compressed = compressed_rollout_path(&raw);
+    std::fs::write(&raw, b"different synthetic bytes\n")?;
+    assert!(open_rollout_line_reader(&compressed).await.is_err());
+    assert!(raw.exists());
+    Ok(())
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn linked_sources_and_replaced_ancestors_are_never_transitioned() -> anyhow::Result<()> {
+    use std::os::unix::fs::symlink;
+
+    let home = TempDir::new()?;
+    let external = TempDir::new()?;
+    let external_path = synthetic_archived_rollout(external.path(), Uuid::now_v7());
+    symlink(
+        external.path().join("archived_sessions"),
+        home.path().join("archived_sessions"),
+    )?;
+    let runtime = state(home.path()).await;
+    assert!(worker::run_once(home.path(), &runtime).await.is_err());
+    assert!(external_path.exists());
+    assert!(!compressed_rollout_path(&external_path).exists());
+    Ok(())
+}
