@@ -0,0 +1,282 @@
+use std::fs::File;
+use std::fs::Metadata;
+use std::fs::OpenOptions;
+use std::io;
+use std::path::Component;
+use std::path::Path;
+use std::path::PathBuf;
+
+use fs2::FileExt;
+use uuid::Uuid;
+
+use crate::ARCHIVED_SESSIONS_SUBDIR;
+use crate::SESSIONS_SUBDIR;
+
+#[cfg(unix)]
+use std::os::unix::fs::MetadataExt;
+#[cfg(unix)]
+use std::os::unix::fs::OpenOptionsExt;
+#[cfg(unix)]
+use std::os::unix::fs::PermissionsExt;
+
+const LEASE_ROOT: &str = ".tmp";
+const LEASE_SUBDIR: &str = "rollout-leases";
+
+/// Cross-process ownership for one rollout representation.
+///
+/// Writers and stable readers hold an exclusive lease for their full lifetime.
+/// Representation transitions use the same lease and compressors acquire it
+/// without waiting, so an active or ambiguous thread always remains untouched.
+#[derive(Debug)]
+pub struct RolloutLease {
+    file: File,
+    path: PathBuf,
+}
+
+#[derive(Debug)]
+pub enum TryRolloutLease {
+    Acquired(RolloutLease),
+    Busy,
+}
+
+impl RolloutLease {
+    pub fn acquire_for_path(rollout_path: &Path) -> io::Result<Self> {
+        let (codex_home, thread_id) = rollout_identity(rollout_path)?;
+        Self::acquire(codex_home.as_path(), thread_id)
+    }
+
+    pub fn try_acquire_for_path(rollout_path: &Path) -> io::Result<TryRolloutLease> {
+        let (codex_home, thread_id) = rollout_identity(rollout_path)?;
+        Self::try_acquire(codex_home.as_path(), thread_id)
+    }
+
+    pub fn acquire(codex_home: &Path, thread_id: Uuid) -> io::Result<Self> {
+        match Self::open(codex_home, thread_id, LockMode::Blocking)? {
+            TryRolloutLease::Acquired(lease) => Ok(lease),
+            TryRolloutLease::Busy => Err(io::Error::new(
+                io::ErrorKind::WouldBlock,
+                "rollout lease unexpectedly busy after blocking acquisition",
+            )),
+        }
+    }
+
+    pub fn try_acquire(codex_home: &Path, thread_id: Uuid) -> io::Result<TryRolloutLease> {
+        Self::open(codex_home, thread_id, LockMode::NonBlocking)
+    }
+
+    pub fn path(&self) -> &Path {
+        self.path.as_path()
+    }
+
+    fn open(codex_home: &Path, thread_id: Uuid, mode: LockMode) -> io::Result<TryRolloutLease> {
+        reject_lexical_escape(codex_home)?;
+        require_real_directory(codex_home, "Codex home")?;
+        let tmp_dir = ensure_private_directory(codex_home, LEASE_ROOT)?;
+        let lease_dir = ensure_private_directory(tmp_dir.as_path(), LEASE_SUBDIR)?;
+        let path = lease_dir.join(format!("{thread_id}.lock"));
+        let before = symlink_metadata_if_present(path.as_path())?;
+        if let Some(metadata) = before.as_ref() {
+            require_regular_unaliased_file(metadata, path.as_path())?;
+        }
+        let file = open_lease_file(path.as_path())?;
+        let opened = file.metadata()?;
+        require_regular_unaliased_file(&opened, path.as_path())?;
+        if let Some(before) = before.as_ref()
+            && !same_file_identity(before, &opened)
+        {
+            return Err(io::Error::other(format!(
+                "rollout lease changed identity while opening: {}",
+                path.display()
+            )));
+        }
+        match mode {
+            LockMode::Blocking => file.lock_exclusive()?,
+            LockMode::NonBlocking => {
+                if let Err(err) = file.try_lock_exclusive() {
+                    if err.kind() == io::ErrorKind::WouldBlock {
+                        return Ok(TryRolloutLease::Busy);
+                    }
+                    return Err(err);
+                }
+            }
+        }
+        let after = std::fs::symlink_metadata(path.as_path())?;
+        let locked = file.metadata()?;
+        if !same_file_identity(&after, &locked) {
+            let _ = file.unlock();
+            return Err(io::Error::other(format!(
+                "rollout lease path was replaced after locking: {}",
+                path.display()
+            )));
+        }
+        Ok(TryRolloutLease::Acquired(Self { file, path }))
+    }
+}
+
+impl Drop for RolloutLease {
+    fn drop(&mut self) {
+        let _ = self.file.unlock();
+    }
+}
+
+#[derive(Clone, Copy)]
+enum LockMode {
+    Blocking,
+    NonBlocking,
+}
+
+fn rollout_identity(path: &Path) -> io::Result<(PathBuf, Uuid)> {
+    reject_lexical_escape(path)?;
+    let thread_id = thread_id_from_rollout_path(path)?;
+    let mut current = path.parent();
+    while let Some(directory) = current {
+        let is_rollout_root = directory
+            .file_name()
+            .and_then(|name| name.to_str())
+            .is_some_and(|name| name == SESSIONS_SUBDIR || name == ARCHIVED_SESSIONS_SUBDIR);
+        if is_rollout_root {
+            let codex_home = directory.parent().ok_or_else(|| {
+                io::Error::new(
+                    io::ErrorKind::InvalidInput,
+                    "rollout root has no Codex home",
+                )
+            })?;
+            return Ok((codex_home.to_path_buf(), thread_id));
+        }
+        current = directory.parent();
+    }
+    Err(io::Error::new(
+        io::ErrorKind::InvalidInput,
+        format!("rollout path is outside a session root: {}", path.display()),
+    ))
+}
+
+fn thread_id_from_rollout_path(path: &Path) -> io::Result<Uuid> {
+    let name = path
+        .file_name()
+        .and_then(|name| name.to_str())
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "non-UTF-8 rollout name"))?;
+    let plain = name.strip_suffix(".zst").unwrap_or(name);
+    let stem = plain
+        .strip_suffix(".jsonl")
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "rollout name is not JSONL"))?;
+    let candidate = stem.get(stem.len().saturating_sub(36)..).ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "rollout name has no thread UUID",
+        )
+    })?;
+    if stem.as_bytes().get(stem.len().saturating_sub(37)) != Some(&b'-') {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "rollout thread UUID is not delimited",
+        ));
+    }
+    let thread_id = Uuid::parse_str(candidate)
+        .map_err(|err| io::Error::new(io::ErrorKind::InvalidInput, err))?;
+    if thread_id.to_string() != candidate {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "rollout thread UUID is not canonical lowercase text",
+        ));
+    }
+    Ok(thread_id)
+}
+
+fn reject_lexical_escape(path: &Path) -> io::Result<()> {
+    if path
+        .components()
+        .any(|component| matches!(component, Component::ParentDir))
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            format!("path contains a parent traversal: {}", path.display()),
+        ));
+    }
+    Ok(())
+}
+
+fn require_real_directory(path: &Path, label: &str) -> io::Result<()> {
+    let metadata = std::fs::symlink_metadata(path)?;
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        return Err(io::Error::other(format!(
+            "{label} is linked or not a directory: {}",
+            path.display()
+        )));
+    }
+    Ok(())
+}
+
+fn ensure_private_directory(parent: &Path, name: &str) -> io::Result<PathBuf> {
+    let path = parent.join(name);
+    match std::fs::create_dir(path.as_path()) {
+        Ok(()) => {}
+        Err(err) if err.kind() == io::ErrorKind::AlreadyExists => {}
+        Err(err) => return Err(err),
+    }
+    require_real_directory(path.as_path(), "rollout lease directory")?;
+    #[cfg(unix)]
+    {
+        std::fs::set_permissions(path.as_path(), std::fs::Permissions::from_mode(0o700))?;
+    }
+    Ok(path)
+}
+
+fn symlink_metadata_if_present(path: &Path) -> io::Result<Option<Metadata>> {
+    match std::fs::symlink_metadata(path) {
+        Ok(metadata) => Ok(Some(metadata)),
+        Err(err) if err.kind() == io::ErrorKind::NotFound => Ok(None),
+        Err(err) => Err(err),
+    }
+}
+
+fn require_regular_unaliased_file(metadata: &Metadata, path: &Path) -> io::Result<()> {
+    if metadata.file_type().is_symlink() || !metadata.is_file() {
+        return Err(io::Error::other(format!(
+            "rollout lease is linked or special: {}",
+            path.display()
+        )));
+    }
+    #[cfg(unix)]
+    if metadata.nlink() != 1 {
+        return Err(io::Error::other(format!(
+            "rollout lease has multiple hard links: {}",
+            path.display()
+        )));
+    }
+    Ok(())
+}
+
+#[cfg(unix)]
+fn open_lease_file(path: &Path) -> io::Result<File> {
+    OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .mode(0o600)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path)
+}
+
+#[cfg(not(unix))]
+fn open_lease_file(path: &Path) -> io::Result<File> {
+    OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .open(path)
+}
+
+#[cfg(unix)]
+fn same_file_identity(left: &Metadata, right: &Metadata) -> bool {
+    left.dev() == right.dev() && left.ino() == right.ino() && left.file_type() == right.file_type()
+}
+
+#[cfg(not(unix))]
+fn same_file_identity(left: &Metadata, right: &Metadata) -> bool {
+    left.file_type() == right.file_type() && left.len() == right.len()
+}
+
+#[cfg(test)]
+#[path = "lease_tests.rs"]
+mod tests;
