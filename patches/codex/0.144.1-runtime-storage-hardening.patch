+CREATE TABLE log_maintenance_state (
+    id INTEGER PRIMARY KEY CHECK (id = 1),
+    claim_generation INTEGER NOT NULL DEFAULT 0,
+    claimed_at INTEGER,
+    claim_expires_at INTEGER,
+    claim_status TEXT NOT NULL DEFAULT 'idle'
+        CHECK (claim_status IN ('idle', 'running', 'failed')),
+    completed_generation INTEGER NOT NULL DEFAULT 0,
+    completed_at INTEGER,
+    next_due_at INTEGER NOT NULL DEFAULT 0,
+    row_count INTEGER NOT NULL DEFAULT 0,
+    estimated_bytes INTEGER NOT NULL DEFAULT 0,
+    thread_partitions INTEGER NOT NULL DEFAULT 0,
+    process_partitions INTEGER NOT NULL DEFAULT 0,
+    over_row_budget INTEGER NOT NULL DEFAULT 0 CHECK (over_row_budget IN (0, 1)),
+    over_byte_budget INTEGER NOT NULL DEFAULT 0 CHECK (over_byte_budget IN (0, 1)),
+    last_result TEXT NOT NULL DEFAULT 'never_run'
+        CHECK (last_result IN ('never_run', 'running', 'measurement_complete', 'measurement_failed')),
+    maintenance_mode TEXT NOT NULL DEFAULT 'observe_only'
+        CHECK (maintenance_mode = 'observe_only'),
+    logical_cap_enforced INTEGER NOT NULL DEFAULT 0 CHECK (logical_cap_enforced = 0),
+    physical_maintenance_enabled INTEGER NOT NULL DEFAULT 0
+        CHECK (physical_maintenance_enabled = 0),
+    checkpoint_status TEXT NOT NULL DEFAULT 'disabled'
+        CHECK (checkpoint_status = 'disabled'),
+    vacuum_status TEXT NOT NULL DEFAULT 'disabled'
+        CHECK (vacuum_status = 'disabled')
+);
+
+INSERT INTO log_maintenance_state (id) VALUES (1);
