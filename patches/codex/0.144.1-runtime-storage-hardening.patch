+async fn reconcile_pending_moves(
+    store: &LocalThreadStore,
+    state_db: Option<&codex_rollout::StateDbHandle>,
+) -> ThreadStoreResult<()> {
+    let receipts = codex_rollout::bundle_move::reconcile_pending_rollout_moves(
+        store.config.codex_home.as_path(),
+    )
+    .map_err(|err| ThreadStoreError::Internal {
+        message: format!("failed to reconcile pending rollout move: {err}"),
+    })?;
+    for receipt in receipts {
+        if let Some(record) =
+            receipt
+                .manifest_record()
+                .map_err(|err| ThreadStoreError::Internal {
+                    message: format!("failed to rebuild pending catalog record: {err}"),
+                })?
+        {
+            let state_db = state_db.ok_or_else(|| ThreadStoreError::Internal {
+                message: "pending compressed move requires a durable local catalog".to_string(),
+            })?;
+            state_db
+                .upsert_runtime_storage_manifest(&record)
+                .await
+                .map_err(|err| ThreadStoreError::Internal {
+                    message: format!("failed to reconcile pending catalog generation: {err:#}"),
+                })?;
+        }
+        codex_rollout::bundle_move::commit_rollout_bundle_move(receipt).map_err(|err| {
+            ThreadStoreError::Internal {
+                message: format!("failed to commit reconciled rollout move: {err}"),
+            }
+        })?;
+    }
