index 0000000000000000000000000000000000000000..6706898d24846eb8504ced74e846e03ccf70fee0
--- /dev/null
+++ b/codex-rs/state/src/runtime/runtime_storage.rs
@@ -0,0 +1,212 @@
+use super::*;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RuntimeStorageManifestRecord {
+    pub thread_id: String,
+    pub schema_version: i64,
+    pub generation: i64,
+    pub source_host: String,
+    pub project: Option<String>,
+    pub cwd: Option<String>,
+    pub title: Option<String>,
+    pub session_created_at: Option<String>,
+    pub session_updated_at: Option<String>,
+    pub raw_path: String,
+    pub compressed_path: String,
+    pub manifest_path: String,
+    pub raw_sha256: String,
+    pub compressed_sha256: String,
+    pub raw_bytes: i64,
+    pub compressed_bytes: i64,
+    pub codec: String,
+    pub codec_version: i64,
+    pub restore_verified_at: i64,
+    pub installed_at: i64,
+    pub pinned: bool,
+    pub representation_state: String,
+}
+
+impl StateRuntime {
+    pub async fn upsert_runtime_storage_manifest(
+        &self,
+        manifest: &RuntimeStorageManifestRecord,
+    ) -> anyhow::Result<()> {
+        // Reserve the SQLite writer before reading the predecessor generation.
+        // A deferred transaction lets two processes read concurrently and then
+        // makes one fail with SQLITE_BUSY while upgrading, which is not a
+        // serialized catalog mutation contract.
+        let mut tx = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        let prior = self
+            .runtime_storage_manifest_in_tx(&mut tx, &manifest.thread_id)
+            .await?;
+        match prior.as_ref() {
+            None if manifest.generation != 1 => {
+                anyhow::bail!(
+                    "runtime-storage catalog requires generation 1 for new thread {}",
+                    manifest.thread_id
+                );
+            }
+            Some(current) if current == manifest => {
+                tx.commit().await?;
+                return Ok(());
+            }
+            Some(current) if manifest.generation != current.generation.saturating_add(1) => {
+                anyhow::bail!(
+                    "runtime-storage catalog expected generation {} after {}, found {} for {}",
+                    current.generation.saturating_add(1),
+                    current.generation,
+                    manifest.generation,
+                    manifest.thread_id
+                );
+            }
+            _ => {}
+        }
+        sqlx::query(
+            r#"
+INSERT INTO runtime_storage_manifests (
+    thread_id, schema_version, generation, source_host, project, cwd, title,
+    session_created_at, session_updated_at, raw_path, compressed_path,
+    manifest_path, raw_sha256, compressed_sha256, raw_bytes,
+    compressed_bytes, codec, codec_version, restore_verified_at,
+    installed_at, pinned, representation_state, catalog_updated_at
+) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+ON CONFLICT(thread_id) DO UPDATE SET
+    schema_version = excluded.schema_version,
+    generation = excluded.generation,
+    source_host = excluded.source_host,
+    project = excluded.project,
+    cwd = excluded.cwd,
+    title = excluded.title,
+    session_created_at = excluded.session_created_at,
+    session_updated_at = excluded.session_updated_at,
+    raw_path = excluded.raw_path,
+    compressed_path = excluded.compressed_path,
+    manifest_path = excluded.manifest_path,
+    raw_sha256 = excluded.raw_sha256,
+    compressed_sha256 = excluded.compressed_sha256,
+    raw_bytes = excluded.raw_bytes,
+    compressed_bytes = excluded.compressed_bytes,
+    codec = excluded.codec,
+    codec_version = excluded.codec_version,
+    restore_verified_at = excluded.restore_verified_at,
+    installed_at = excluded.installed_at,
+    pinned = excluded.pinned,
+    representation_state = excluded.representation_state,
+    catalog_updated_at = excluded.catalog_updated_at
+WHERE excluded.generation = runtime_storage_manifests.generation + 1
+            "#,
+        )
+        .bind(&manifest.thread_id)
+        .bind(manifest.schema_version)
+        .bind(manifest.generation)
+        .bind(&manifest.source_host)
+        .bind(&manifest.project)
+        .bind(&manifest.cwd)
+        .bind(&manifest.title)
+        .bind(&manifest.session_created_at)
+        .bind(&manifest.session_updated_at)
+        .bind(&manifest.raw_path)
+        .bind(&manifest.compressed_path)
+        .bind(&manifest.manifest_path)
+        .bind(&manifest.raw_sha256)
+        .bind(&manifest.compressed_sha256)
+        .bind(manifest.raw_bytes)
+        .bind(manifest.compressed_bytes)
+        .bind(&manifest.codec)
+        .bind(manifest.codec_version)
+        .bind(manifest.restore_verified_at)
+        .bind(manifest.installed_at)
+        .bind(manifest.pinned)
+        .bind(&manifest.representation_state)
+        .bind(chrono::Utc::now().timestamp())
+        .execute(&mut *tx)
+        .await?
+        .rows_affected();
+        let committed = self
+            .runtime_storage_manifest_in_tx(&mut tx, &manifest.thread_id)
+            .await?;
+        if committed.as_ref() != Some(manifest) {
+            anyhow::bail!(
+                "runtime-storage catalog refused stale or disagreeing generation for {}",
+                manifest.thread_id
+            );
+        }
+        tx.commit().await?;
+        Ok(())
+    }
+
+    async fn runtime_storage_manifest_in_tx(
+        &self,
+        tx: &mut sqlx::Transaction<'_, Sqlite>,
+        thread_id: &str,
+    ) -> anyhow::Result<Option<RuntimeStorageManifestRecord>> {
+        let row = sqlx::query(
+            r#"
+SELECT thread_id, schema_version, generation, source_host, project, cwd, title,
+       session_created_at, session_updated_at, raw_path, compressed_path,
+       manifest_path, raw_sha256, compressed_sha256, raw_bytes,
+       compressed_bytes, codec, codec_version, restore_verified_at,
+       installed_at, pinned, representation_state
+FROM runtime_storage_manifests WHERE thread_id = ?
+            "#,
+        )
+        .bind(thread_id)
+        .fetch_optional(&mut **tx)
+        .await?;
+        row.map(runtime_storage_record_from_row).transpose()
+    }
+
+    pub async fn runtime_storage_manifest(
+        &self,
+        thread_id: &str,
+    ) -> anyhow::Result<Option<RuntimeStorageManifestRecord>> {
+        let row = sqlx::query(
+            r#"
+SELECT thread_id, schema_version, generation, source_host, project, cwd, title,
+       session_created_at, session_updated_at, raw_path, compressed_path,
+       manifest_path, raw_sha256, compressed_sha256, raw_bytes,
+       compressed_bytes, codec, codec_version, restore_verified_at,
+       installed_at, pinned, representation_state
+FROM runtime_storage_manifests
+WHERE thread_id = ?
+            "#,
+        )
+        .bind(thread_id)
+        .fetch_optional(self.pool.as_ref())
+        .await?;
+        row.map(runtime_storage_record_from_row).transpose()
+    }
+}
+
+fn runtime_storage_record_from_row(
+    row: sqlx::sqlite::SqliteRow,
+) -> anyhow::Result<RuntimeStorageManifestRecord> {
+    Ok(RuntimeStorageManifestRecord {
+        thread_id: row.try_get("thread_id")?,
+        schema_version: row.try_get("schema_version")?,
+        generation: row.try_get("generation")?,
+        source_host: row.try_get("source_host")?,
+        project: row.try_get("project")?,
