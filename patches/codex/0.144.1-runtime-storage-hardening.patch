diff --git a/codex-rs/rollout/src/bundle_move.rs b/codex-rs/rollout/src/bundle_move.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2370e9da4bfc9ea978f875d703cb28b6fa9d4a24
--- /dev/null
+++ b/codex-rs/rollout/src/bundle_move.rs
@@ -0,0 +1,432 @@
+use std::fs::Metadata;
+use std::io;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+use serde::Deserialize;
+use serde::Serialize;
+
+use crate::lease::RolloutLease;
+use crate::manifest;
+
+#[cfg(unix)]
+use std::os::unix::fs::MetadataExt;
+#[cfg(unix)]
+use std::os::unix::fs::PermissionsExt;
+
+const JOURNAL_SCHEMA_VERSION: u32 = 1;
+
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+struct MoveEntry {
+    source: String,
+    destination: String,
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+struct MoveJournal {
+    schema_version: u32,
+    generation: u64,
+    thread_id: String,
+    source_plain: String,
+    destination_plain: String,
+    entries: Vec<MoveEntry>,
+    phase: String,
+}
+
+#[derive(Debug)]
+pub struct RolloutBundleMoveReceipt {
+    journal_path: PathBuf,
+    actual_path: PathBuf,
+    manifest_path: Option<PathBuf>,
+    manifest: Option<manifest::LosslessRolloutManifest>,
+    owned_lease: Option<RolloutLease>,
+}
+
+impl RolloutBundleMoveReceipt {
+    pub fn actual_path(&self) -> &Path {
+        self.actual_path.as_path()
+    }
+
+    pub fn manifest_record(&self) -> io::Result<Option<codex_state::RuntimeStorageManifestRecord>> {
+        self.manifest
+            .as_ref()
+            .zip(self.manifest_path.as_ref())
+            .map(|(manifest, path)| manifest.to_state_record(path.as_path()))
+            .transpose()
+    }
+}
+
+pub fn begin_rollout_bundle_move(
+    source: &Path,
+    destination_plain: &Path,
+    lease: &RolloutLease,
+) -> io::Result<RolloutBundleMoveReceipt> {
+    let source_plain = crate::plain_rollout_path(source);
+    let destination_plain = crate::plain_rollout_path(destination_plain);
+    let journal_path = journal_path(lease)?;
+    let mut journal = match read_optional_journal(journal_path.as_path())? {
+        Some(existing) => {
+            if existing.source_plain != path_text(source_plain.as_path())?
+                || existing.destination_plain != path_text(destination_plain.as_path())?
+            {
+                return Err(io::Error::other(format!(
+                    "unfinished rollout move conflicts with requested direction: {}",
+                    journal_path.display()
+                )));
+            }
+            existing
+        }
+        None => {
+            let journal =
+                build_journal(source_plain.as_path(), destination_plain.as_path(), lease)?;
+            install_new_journal(journal_path.as_path(), &journal)?;
+            journal
+        }
+    };
+    reconcile_journal(journal_path.as_path(), &mut journal, lease)
+}
+
+pub fn reconcile_pending_rollout_moves(
+    codex_home: &Path,
+) -> io::Result<Vec<RolloutBundleMoveReceipt>> {
+    let root = codex_home.join(".tmp/rollout-moves");
+    match std::fs::symlink_metadata(root.as_path()) {
+        Err(err) if err.kind() == io::ErrorKind::NotFound => return Ok(Vec::new()),
+        Err(err) => return Err(err),
+        Ok(metadata) if metadata.file_type().is_symlink() || !metadata.is_dir() => {
+            return Err(io::Error::other(
+                "rollout move journal root is linked or not a directory",
+            ));
+        }
+        Ok(_) => {}
+    }
+    let mut receipts = Vec::new();
+    for entry in std::fs::read_dir(root.as_path())? {
+        let entry = entry?;
+        let metadata = entry.file_type()?;
+        if !metadata.is_file()
+            || entry.path().extension().and_then(|value| value.to_str()) != Some("json")
+        {
+            continue;
+        }
+        let mut journal = read_journal(entry.path().as_path())?;
+        let lease = RolloutLease::acquire_for_path(Path::new(journal.source_plain.as_str()))?;
+        let mut receipt = reconcile_journal(entry.path().as_path(), &mut journal, &lease)?;
+        receipt.owned_lease = Some(lease);
+        receipts.push(receipt);
+    }
+    Ok(receipts)
+}
+
+pub fn commit_rollout_bundle_move(receipt: RolloutBundleMoveReceipt) -> io::Result<()> {
+    let parent = receipt
+        .journal_path
+        .parent()
+        .ok_or_else(|| io::Error::other("rollout move journal has no parent"))?;
+    std::fs::remove_file(receipt.journal_path.as_path())?;
+    manifest::sync_directory(parent)
+}
+
+fn build_journal(
+    source_plain: &Path,
+    destination_plain: &Path,
+    lease: &RolloutLease,
+) -> io::Result<MoveJournal> {
+    let source_compressed = compressed_path(source_plain);
+    let source_manifest = manifest::manifest_path(source_compressed.as_path());
+    let destination_compressed = compressed_path(destination_plain);
+    let destination_manifest = manifest::manifest_path(destination_compressed.as_path());
+    let candidates = [
+        (source_compressed, destination_compressed),
+        (source_manifest, destination_manifest),
+        (source_plain.to_path_buf(), destination_plain.to_path_buf()),
+    ];
+    let mut entries = Vec::new();
+    for (source, destination) in candidates {
+        if source.try_exists()? {
+            checked_regular_metadata(source.as_path())?;
+            if destination.try_exists()? {
+                return Err(io::Error::new(
+                    io::ErrorKind::AlreadyExists,
+                    format!(
+                        "rollout move destination already exists: {}",
+                        destination.display()
+                    ),
+                ));
+            }
+            entries.push(MoveEntry {
+                source: path_text(source.as_path())?,
+                destination: path_text(destination.as_path())?,
+            });
+        }
+    }
+    if entries.is_empty() {
+        return Err(io::Error::new(
+            io::ErrorKind::NotFound,
+            "rollout move has no source representation",
+        ));
+    }
+    let existing_manifest = entries
+        .iter()
+        .find(|entry| entry.source.ends_with(".manifest.json"))
+        .map(|entry| manifest::read_manifest(Path::new(entry.source.as_str())))
+        .transpose()?;
+    let generation = existing_manifest
+        .as_ref()
+        .map(|manifest| manifest.generation.saturating_add(1))
+        .unwrap_or(1);
+    let thread_id = lease
+        .path()
+        .file_stem()
+        .and_then(|value| value.to_str())
+        .ok_or_else(|| io::Error::other("rollout lease path has no thread id"))?
+        .to_string();
+    Ok(MoveJournal {
+        schema_version: JOURNAL_SCHEMA_VERSION,
+        generation,
+        thread_id,
+        source_plain: path_text(source_plain)?,
+        destination_plain: path_text(destination_plain)?,
+        entries,
+        phase: "prepared".to_string(),
+    })
+}
+
+fn reconcile_journal(
+    journal_path: &Path,
+    journal: &mut MoveJournal,
+    _lease: &RolloutLease,
+) -> io::Result<RolloutBundleMoveReceipt> {
+    if journal.schema_version != JOURNAL_SCHEMA_VERSION || journal.entries.is_empty() {
+        return Err(io::Error::other("unknown or empty rollout move journal"));
+    }
+    for entry in &journal.entries {
+        let source = Path::new(entry.source.as_str());
+        let destination = Path::new(entry.destination.as_str());
+        let source_metadata = optional_checked_metadata(source)?;
+        let destination_metadata = optional_checked_metadata(destination)?;
+        match (source_metadata, destination_metadata) {
+            (Some(_), None) => {
+                std::fs::rename(source, destination)?;
+                sync_move_directories(source, destination)?;
+            }
+            (None, Some(_)) => {}
+            (Some(_), Some(_)) => {
+                return Err(io::Error::other(format!(
+                    "ambiguous rollout move has both source and destination: {}",
+                    destination.display()
+                )));
+            }
+            (None, None) => {
+                return Err(io::Error::other(format!(
+                    "rollout move lost both source and destination: {}",
+                    destination.display()
+                )));
+            }
+        }
+    }
+
+    let destination_plain = PathBuf::from(journal.destination_plain.as_str());
+    let destination_compressed = compressed_path(destination_plain.as_path());
+    let destination_manifest = manifest::manifest_path(destination_compressed.as_path());
+    let moved_manifest = if destination_manifest.try_exists()? {
+        let mut moved = manifest::read_manifest(destination_manifest.as_path())?;
+        moved.generation = journal.generation;
+        moved.raw_path = journal.destination_plain.clone();
+        moved.compressed_path = path_text(destination_compressed.as_path())?;
+        manifest::verify_installed_representation(&moved, destination_compressed.as_path())?;
+        manifest::replace_manifest(&moved, destination_manifest.as_path())?;
+        Some(moved)
+    } else {
+        None
+    };
+    journal.phase = "representations_moved".to_string();
+    replace_journal(journal_path, journal)?;
+    let actual_path = if destination_plain.exists() {
+        destination_plain
+    } else if destination_compressed.exists() {
+        destination_compressed
+    } else {
+        return Err(io::Error::other(
+            "reconciled rollout move has no representation",
+        ));
+    };
+    Ok(RolloutBundleMoveReceipt {
+        journal_path: journal_path.to_path_buf(),
+        actual_path,
+        manifest_path: moved_manifest.as_ref().map(|_| destination_manifest),
+        manifest: moved_manifest,
+        owned_lease: None,
+    })
+}
+
+fn journal_path(lease: &RolloutLease) -> io::Result<PathBuf> {
+    let lease_root = lease
+        .path()
+        .parent()
+        .ok_or_else(|| io::Error::other("rollout lease has no parent"))?;
+    let tmp_root = lease_root
+        .parent()
+        .ok_or_else(|| io::Error::other("rollout lease root has no parent"))?;
+    let root = tmp_root.join("rollout-moves");
+    match std::fs::create_dir(root.as_path()) {
+        Ok(()) => {}
+        Err(err) if err.kind() == io::ErrorKind::AlreadyExists => {}
+        Err(err) => return Err(err),
+    }
+    let metadata = std::fs::symlink_metadata(root.as_path())?;
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        return Err(io::Error::other(
+            "rollout move journal root is linked or not a directory",
+        ));
+    }
+    #[cfg(unix)]
+    std::fs::set_permissions(root.as_path(), std::fs::Permissions::from_mode(0o700))?;
+    let thread_id = lease
+        .path()
+        .file_stem()
+        .ok_or_else(|| io::Error::other("rollout lease has no thread id"))?;
+    Ok(root.join(thread_id).with_extension("json"))
+}
+
+fn install_new_journal(path: &Path, journal: &MoveJournal) -> io::Result<()> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| io::Error::other("journal has no parent"))?;
+    let mut temporary = tempfile::Builder::new()
+        .prefix("rollout-move-")
+        .suffix(".tmp")
+        .tempfile_in(parent)?;
+    serde_json::to_writer(temporary.as_file_mut(), journal).map_err(io::Error::other)?;
+    temporary.as_file_mut().flush()?;
+    temporary.as_file().sync_all()?;
+    temporary.persist_noclobber(path).map_err(|err| err.error)?;
+    manifest::sync_directory(parent)
+}
+
+fn replace_journal(path: &Path, journal: &MoveJournal) -> io::Result<()> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| io::Error::other("journal has no parent"))?;
+    let mut temporary = tempfile::Builder::new()
+        .prefix("rollout-move-update-")
+        .suffix(".tmp")
+        .tempfile_in(parent)?;
+    serde_json::to_writer(temporary.as_file_mut(), journal).map_err(io::Error::other)?;
+    temporary.as_file_mut().flush()?;
+    temporary.as_file().sync_all()?;
+    temporary.persist(path).map_err(|err| err.error)?;
+    manifest::sync_directory(parent)
+}
+
+fn read_optional_journal(path: &Path) -> io::Result<Option<MoveJournal>> {
+    match std::fs::symlink_metadata(path) {
+        Ok(_) => read_journal(path).map(Some),
+        Err(err) if err.kind() == io::ErrorKind::NotFound => Ok(None),
+        Err(err) => Err(err),
+    }
+}
+
+fn read_journal(path: &Path) -> io::Result<MoveJournal> {
+    let metadata = checked_regular_metadata(path)?;
+    if metadata.len() > 128 * 1024 {
+        return Err(io::Error::other("rollout move journal exceeds 128 KiB"));
+    }
+    let file = std::fs::File::open(path)?;
+    serde_json::from_reader(file).map_err(io::Error::other)
+}
+
+fn compressed_path(path: &Path) -> PathBuf {
+    let mut name = path.file_name().unwrap_or_default().to_os_string();
+    name.push(".zst");
+    path.with_file_name(name)
+}
+
+fn sync_move_directories(source: &Path, destination: &Path) -> io::Result<()> {
+    if let Some(parent) = source.parent() {
+        fail_directory_sync_for_test()?;
+        manifest::sync_directory(parent)?;
+    }
+    if let Some(parent) = destination.parent()
+        && source.parent() != Some(parent)
+    {
+        fail_directory_sync_for_test()?;
+        manifest::sync_directory(parent)?;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+thread_local! {
+    static FAIL_DIRECTORY_SYNC_AT: std::cell::Cell<Option<usize>> = const { std::cell::Cell::new(None) };
+    static DIRECTORY_SYNC_COUNT: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+}
+
+#[cfg(test)]
+fn configure_directory_sync_failure(at: Option<usize>) {
+    FAIL_DIRECTORY_SYNC_AT.set(at);
+    DIRECTORY_SYNC_COUNT.set(0);
+}
+
+#[cfg(test)]
+fn fail_directory_sync_for_test() -> io::Result<()> {
+    let count = DIRECTORY_SYNC_COUNT.get();
+    DIRECTORY_SYNC_COUNT.set(count.saturating_add(1));
+    if FAIL_DIRECTORY_SYNC_AT.get() == Some(count) {
+        return Err(io::Error::new(
+            io::ErrorKind::Other,
+            "synthetic directory fsync failure",
+        ));
+    }
+    Ok(())
+}
+
+#[cfg(not(test))]
+fn fail_directory_sync_for_test() -> io::Result<()> {
+    Ok(())
+}
+
+fn optional_checked_metadata(path: &Path) -> io::Result<Option<Metadata>> {
+    match std::fs::symlink_metadata(path) {
+        Ok(metadata) => {
+            require_regular_unaliased(&metadata, path)?;
+            Ok(Some(metadata))
+        }
+        Err(err) if err.kind() == io::ErrorKind::NotFound => Ok(None),
+        Err(err) => Err(err),
+    }
+}
+
+fn checked_regular_metadata(path: &Path) -> io::Result<Metadata> {
+    let metadata = std::fs::symlink_metadata(path)?;
+    require_regular_unaliased(&metadata, path)?;
+    Ok(metadata)
+}
+
+fn require_regular_unaliased(metadata: &Metadata, path: &Path) -> io::Result<()> {
+    if metadata.file_type().is_symlink() || !metadata.is_file() {
+        return Err(io::Error::other(format!(
+            "rollout move path is linked or special: {}",
+            path.display()
+        )));
+    }
+    #[cfg(unix)]
+    if metadata.nlink() != 1 {
+        return Err(io::Error::other(format!(
+            "rollout move path has hard-link aliases: {}",
+            path.display()
+        )));
+    }
+    Ok(())
+}
+
+fn path_text(path: &Path) -> io::Result<String> {
+    path.to_str()
+        .map(str::to_owned)
+        .ok_or_else(|| io::Error::other("rollout move path is not UTF-8"))
+}
+
