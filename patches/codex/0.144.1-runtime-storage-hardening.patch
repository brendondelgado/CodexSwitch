+fn delete_rollout_sidecar(store: &LocalThreadStore, path: &Path) -> ThreadStoreResult<bool> {
+    let plain = path
+        .file_name()
+        .and_then(|name| name.to_str())
+        .and_then(|name| name.strip_suffix(".zst.manifest.json"))
+        .ok_or_else(|| ThreadStoreError::InvalidRequest {
+            message: format!("invalid rollout manifest path `{}`", path.display()),
+        })?;
+    if !plain.ends_with(".jsonl") {
+        return Err(ThreadStoreError::InvalidRequest {
+            message: format!("invalid rollout manifest path `{}`", path.display()),
+        });
+    }
+    let in_sessions = path.starts_with(store.config.codex_home.join(SESSIONS_SUBDIR));
+    let in_archive = path.starts_with(store.config.codex_home.join(ARCHIVED_SESSIONS_SUBDIR));
+    if !in_sessions && !in_archive {
+        return Err(ThreadStoreError::InvalidRequest {
+            message: format!(
+                "rollout manifest is outside session roots `{}`",
+                path.display()
+            ),
+        });
+    }
+    match std::fs::remove_file(path) {
+        Ok(()) => Ok(true),
+        Err(err) if err.kind() == ErrorKind::NotFound => Ok(false),
+        Err(err) => Err(ThreadStoreError::Internal {
+            message: format!(
+                "failed to delete rollout manifest `{}`: {err}",
+                path.display()
+            ),
+        }),
+    }
 }
 
