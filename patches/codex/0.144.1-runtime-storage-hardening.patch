@@ -0,0 +1,397 @@
+use std::fs::File;
+use std::fs::Metadata;
+use std::io;
+use std::io::BufRead;
+use std::io::BufReader;
+use std::io::Read;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+use serde::Deserialize;
+use serde::Serialize;
+use sha2::Digest;
+use sha2::Sha256;
+use uuid::Uuid;
+
+#[cfg(unix)]
+use std::os::unix::fs::MetadataExt;
+#[cfg(unix)]
+use std::os::unix::fs::OpenOptionsExt;
+
+pub const MANIFEST_SCHEMA_VERSION: u32 = 1;
+pub const CODEC_VERSION: u32 = 1;
+
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+pub struct LosslessRolloutManifest {
+    pub schema_version: u32,
+    pub generation: u64,
+    pub thread_id: String,
+    pub source_host: String,
+    pub project: Option<String>,
+    pub cwd: Option<String>,
+    pub title: Option<String>,
+    pub session_created_at: Option<String>,
+    pub session_updated_at: Option<String>,
+    pub raw_path: String,
+    pub compressed_path: String,
+    pub raw_sha256: String,
+    pub compressed_sha256: String,
+    pub raw_bytes: u64,
+    pub compressed_bytes: u64,
+    pub codec: String,
+    pub codec_version: u32,
+    pub zstd_level: i32,
+    pub zstd_frame_checksum: bool,
+    pub installed_at: i64,
+    pub restore_verified_at: i64,
+    pub pinned: bool,
+    pub representation_state: String,
+}
+
+impl LosslessRolloutManifest {
+    pub fn to_state_record(
+        &self,
+        manifest_path: &Path,
+    ) -> io::Result<codex_state::RuntimeStorageManifestRecord> {
+        Ok(codex_state::RuntimeStorageManifestRecord {
+            thread_id: self.thread_id.clone(),
+            schema_version: i64::from(self.schema_version),
+            generation: i64::try_from(self.generation)
+                .map_err(|_| io::Error::other("manifest generation exceeds SQLite integer"))?,
+            source_host: self.source_host.clone(),
+            project: self.project.clone(),
+            cwd: self.cwd.clone(),
+            title: self.title.clone(),
+            session_created_at: self.session_created_at.clone(),
+            session_updated_at: self.session_updated_at.clone(),
+            raw_path: self.raw_path.clone(),
+            compressed_path: self.compressed_path.clone(),
+            manifest_path: path_text(manifest_path)?,
+            raw_sha256: self.raw_sha256.clone(),
+            compressed_sha256: self.compressed_sha256.clone(),
+            raw_bytes: i64::try_from(self.raw_bytes)
+                .map_err(|_| io::Error::other("raw rollout length exceeds SQLite integer"))?,
+            compressed_bytes: i64::try_from(self.compressed_bytes).map_err(|_| {
+                io::Error::other("compressed rollout length exceeds SQLite integer")
+            })?,
+            codec: self.codec.clone(),
+            codec_version: i64::from(self.codec_version),
+            restore_verified_at: self.restore_verified_at,
+            installed_at: self.installed_at,
+            pinned: self.pinned,
+            representation_state: self.representation_state.clone(),
+        })
+    }
+}
+
+pub fn manifest_path(compressed_path: &Path) -> PathBuf {
+    let mut name = compressed_path
+        .file_name()
+        .unwrap_or_default()
+        .to_os_string();
+    name.push(".manifest.json");
+    compressed_path.with_file_name(name)
+}
+
+pub fn build_verified_manifest(
+    raw_path: &Path,
+    compressed_path: &Path,
+    zstd_level: i32,
+) -> io::Result<LosslessRolloutManifest> {
+    let raw_metadata = checked_regular_metadata(raw_path)?;
+    let compressed_metadata = checked_regular_metadata(compressed_path)?;
+    let session = read_session_metadata(raw_path)?;
+    let file_thread_id = thread_id_from_name(raw_path)?;
+    if session.thread_id != file_thread_id.to_string() {
+        return Err(io::Error::other(format!(
+            "rollout SessionMeta id {} does not match filename {file_thread_id}",
+            session.thread_id
+        )));
+    }
+    let raw_digest = digest_file(raw_path)?;
+    let compressed_digest = digest_file(compressed_path)?;
+    let (decoded_digest, decoded_bytes) = digest_decoded_zstd(compressed_path)?;
+    if decoded_digest != raw_digest || decoded_bytes != raw_metadata.len() {
+        return Err(io::Error::other(
+            "decoded zstd bytes do not reproduce the raw rollout digest and length",
+        ));
+    }
+    let now = unix_seconds(SystemTime::now())?;
+    let session_updated_at = raw_metadata
+        .modified()
+        .ok()
+        .and_then(|value| unix_seconds(value).ok())
+        .map(|value| value.to_string());
+    let cwd = session.cwd;
+    let project = cwd.as_deref().and_then(|value| {
+        Path::new(value)
+            .file_name()
+            .and_then(|name| name.to_str())
+            .map(str::to_owned)
+    });
+    Ok(LosslessRolloutManifest {
+        schema_version: MANIFEST_SCHEMA_VERSION,
+        generation: 1,
+        thread_id: file_thread_id.to_string(),
+        source_host: gethostname::gethostname().to_string_lossy().into_owned(),
+        project,
+        cwd,
+        title: None,
+        session_created_at: session.created_at,
+        session_updated_at,
+        raw_path: path_text(raw_path)?,
+        compressed_path: path_text(compressed_path)?,
+        raw_sha256: raw_digest,
+        compressed_sha256: compressed_digest,
+        raw_bytes: raw_metadata.len(),
+        compressed_bytes: compressed_metadata.len(),
+        codec: "zstd".to_string(),
+        codec_version: CODEC_VERSION,
+        zstd_level,
+        zstd_frame_checksum: true,
+        installed_at: now,
+        restore_verified_at: now,
+        pinned: pin_path(raw_path).exists(),
+        representation_state: "compressed_verified".to_string(),
+    })
+}
+
+pub fn install_manifest(
+    manifest: &LosslessRolloutManifest,
+    compressed_path: &Path,
+) -> io::Result<PathBuf> {
+    let destination = manifest_path(compressed_path);
+    let parent = destination
+        .parent()
+        .ok_or_else(|| io::Error::other("manifest destination has no parent"))?;
+    let bytes = serde_json::to_vec(manifest).map_err(io::Error::other)?;
+    if destination.exists() {
+        let existing = read_manifest(destination.as_path())?;
+        if existing == *manifest {
+            return Ok(destination);
+        }
+        return Err(io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            format!(
+                "manifest already exists with different bytes: {}",
+                destination.display()
+            ),
+        ));
+    }
+    let mut temporary = tempfile::Builder::new()
+        .prefix("rollout-manifest-")
+        .suffix(".tmp")
+        .tempfile_in(parent)?;
+    temporary.write_all(bytes.as_slice())?;
+    temporary.flush()?;
+    temporary.as_file().sync_all()?;
+    temporary
+        .persist_noclobber(destination.as_path())
+        .map_err(|err| err.error)?;
+    sync_directory(parent)?;
+    Ok(destination)
+}
+
+pub fn replace_manifest(manifest: &LosslessRolloutManifest, destination: &Path) -> io::Result<()> {
+    let parent = destination
+        .parent()
+        .ok_or_else(|| io::Error::other("manifest destination has no parent"))?;
+    let bytes = serde_json::to_vec(manifest).map_err(io::Error::other)?;
+    let mut temporary = tempfile::Builder::new()
+        .prefix("rollout-manifest-replace-")
+        .suffix(".tmp")
+        .tempfile_in(parent)?;
+    temporary.write_all(bytes.as_slice())?;
+    temporary.flush()?;
+    temporary.as_file().sync_all()?;
+    temporary.persist(destination).map_err(|err| err.error)?;
+    sync_directory(parent)
+}
+
+pub fn read_manifest(path: &Path) -> io::Result<LosslessRolloutManifest> {
+    let metadata = checked_regular_metadata(path)?;
+    if metadata.len() > 64 * 1024 {
+        return Err(io::Error::other("rollout manifest exceeds 64 KiB"));
+    }
+    let file = open_read_nofollow(path)?;
+    let mut bytes = Vec::with_capacity(metadata.len() as usize);
+    file.take(64 * 1024 + 1).read_to_end(&mut bytes)?;
+    if bytes.len() > 64 * 1024 {
+        return Err(io::Error::other("rollout manifest exceeds 64 KiB"));
+    }
+    let manifest: LosslessRolloutManifest =
+        serde_json::from_slice(bytes.as_slice()).map_err(io::Error::other)?;
+    if manifest.schema_version != MANIFEST_SCHEMA_VERSION
+        || manifest.codec != "zstd"
+        || manifest.codec_version != CODEC_VERSION
+        || !manifest.zstd_frame_checksum
+    {
+        return Err(io::Error::other("unsupported rollout manifest contract"));
+    }
+    Ok(manifest)
+}
+
+pub fn verify_installed_representation(
+    manifest: &LosslessRolloutManifest,
+    compressed_path: &Path,
+) -> io::Result<()> {
+    let compressed_metadata = checked_regular_metadata(compressed_path)?;
+    if compressed_metadata.len() != manifest.compressed_bytes
+        || digest_file(compressed_path)? != manifest.compressed_sha256
+    {
+        return Err(io::Error::other(
+            "compressed rollout digest or length changed",
+        ));
+    }
+    let (decoded_digest, decoded_bytes) = digest_decoded_zstd(compressed_path)?;
+    if decoded_bytes != manifest.raw_bytes || decoded_digest != manifest.raw_sha256 {
+        return Err(io::Error::other(
+            "restored rollout digest or length changed",
+        ));
+    }
+    Ok(())
+}
+
+pub fn digest_decoded_zstd(path: &Path) -> io::Result<(String, u64)> {
+    let input = open_read_nofollow(path)?;
+    let mut decoder = zstd::stream::read::Decoder::new(input)?;
+    digest_reader(&mut decoder)
+}
+
+pub fn digest_file(path: &Path) -> io::Result<String> {
+    let mut file = open_read_nofollow(path)?;
+    digest_reader(&mut file).map(|(digest, _)| digest)
+}
+
+pub fn sync_directory(path: &Path) -> io::Result<()> {
+    File::open(path)?.sync_all()
+}
+
+fn digest_reader(reader: &mut impl Read) -> io::Result<(String, u64)> {
+    let mut hasher = Sha256::new();
+    let mut total = 0u64;
+    let mut buffer = [0u8; 64 * 1024];
+    loop {
+        let read = reader.read(&mut buffer)?;
+        if read == 0 {
+            break;
+        }
+        hasher.update(&buffer[..read]);
+        total = total.saturating_add(read as u64);
+    }
+    Ok((format!("{:x}", hasher.finalize()), total))
+}
+
+#[derive(Deserialize)]
+struct SessionEnvelope {
+    #[serde(rename = "type")]
+    kind: String,
+    payload: SessionPayload,
+}
+
+#[derive(Deserialize)]
+struct SessionPayload {
+    id: String,
+    cwd: Option<String>,
+    timestamp: Option<String>,
+}
+
+struct SessionMetadata {
+    thread_id: String,
+    cwd: Option<String>,
+    created_at: Option<String>,
+}
+
+fn read_session_metadata(path: &Path) -> io::Result<SessionMetadata> {
+    let file = open_read_nofollow(path)?;
+    let mut line = String::new();
+    BufReader::new(file)
+        .take(1024 * 1024)
+        .read_line(&mut line)?;
+    let envelope: SessionEnvelope = serde_json::from_str(&line).map_err(io::Error::other)?;
+    if envelope.kind != "session_meta" {
+        return Err(io::Error::other("first rollout line is not SessionMeta"));
+    }
+    Ok(SessionMetadata {
+        thread_id: envelope.payload.id,
+        cwd: envelope.payload.cwd,
+        created_at: envelope.payload.timestamp,
+    })
+}
+
+fn thread_id_from_name(path: &Path) -> io::Result<Uuid> {
+    let name = path
+        .file_name()
+        .and_then(|name| name.to_str())
+        .ok_or_else(|| io::Error::other("rollout filename is not UTF-8"))?;
+    let plain = name.strip_suffix(".zst").unwrap_or(name);
+    let stem = plain
+        .strip_suffix(".jsonl")
+        .ok_or_else(|| io::Error::other("rollout filename is not JSONL"))?;
+    let candidate = stem
+        .get(stem.len().saturating_sub(36)..)
+        .ok_or_else(|| io::Error::other("rollout filename has no thread UUID"))?;
+    let thread_id = Uuid::parse_str(candidate).map_err(io::Error::other)?;
+    if thread_id.to_string() != candidate {
+        return Err(io::Error::other("rollout filename UUID is not canonical"));
+    }
+    Ok(thread_id)
+}
+
+fn pin_path(raw_path: &Path) -> PathBuf {
+    let mut name = raw_path.file_name().unwrap_or_default().to_os_string();
+    name.push(".pin");
+    raw_path.with_file_name(name)
+}
+
+fn checked_regular_metadata(path: &Path) -> io::Result<Metadata> {
+    let metadata = std::fs::symlink_metadata(path)?;
+    if metadata.file_type().is_symlink() || !metadata.is_file() {
+        return Err(io::Error::other(format!(
+            "runtime storage path is linked or special: {}",
+            path.display()
+        )));
+    }
+    #[cfg(unix)]
+    if metadata.nlink() != 1 {
+        return Err(io::Error::other(format!(
+            "runtime storage path has multiple hard links: {}",
+            path.display()
+        )));
+    }
+    Ok(metadata)
+}
+
+#[cfg(unix)]
+fn open_read_nofollow(path: &Path) -> io::Result<File> {
+    std::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path)
+}
+
+#[cfg(not(unix))]
+fn open_read_nofollow(path: &Path) -> io::Result<File> {
+    File::open(path)
+}
+
+fn path_text(path: &Path) -> io::Result<String> {
+    path.to_str()
+        .map(str::to_owned)
+        .ok_or_else(|| io::Error::other("runtime storage path is not UTF-8"))
+}
+
+fn unix_seconds(value: SystemTime) -> io::Result<i64> {
+    let seconds = value
+        .duration_since(UNIX_EPOCH)
+        .map_err(io::Error::other)?
+        .as_secs();
+    i64::try_from(seconds).map_err(io::Error::other)
+}
+
+#[cfg(test)]
+#[path = "manifest_tests.rs"]
+mod tests;
