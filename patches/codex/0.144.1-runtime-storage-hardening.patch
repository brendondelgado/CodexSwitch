+use std::fs::OpenOptions;
+
+use pretty_assertions::assert_eq;
+use tempfile::TempDir;
+use uuid::Uuid;
+
+use super::*;
+
+fn rollout_path(home: &Path, thread_id: Uuid) -> PathBuf {
+    home.join("sessions/2026/07/17")
+        .join(format!("rollout-2026-07-17T12-00-00-{thread_id}.jsonl"))
+}
+
+#[test]
+fn competing_process_style_acquisition_is_nonblocking() {
+    let home = TempDir::new().expect("temp home");
+    std::fs::create_dir_all(home.path().join("sessions/2026/07/17")).expect("sessions");
+    let path = rollout_path(home.path(), Uuid::now_v7());
+    let lease = RolloutLease::acquire_for_path(path.as_path()).expect("first lease");
+    assert!(matches!(
+        RolloutLease::try_acquire_for_path(path.as_path()).expect("second attempt"),
+        TryRolloutLease::Busy
+    ));
+    drop(lease);
+    assert!(matches!(
+        RolloutLease::try_acquire_for_path(path.as_path()).expect("released attempt"),
+        TryRolloutLease::Acquired(_)
+    ));
+}
+
+#[cfg(unix)]
+#[test]
+fn paused_subprocess_cannot_be_expired_and_death_releases_kernel_lease() {
+    use std::process::Command;
+    use std::process::Stdio;
+    use std::thread;
+    use std::time::Duration;
+
+    const CHILD: &str = "CODEX_RUNTIME_STORAGE_LEASE_CHILD";
+    const PATH: &str = "CODEX_RUNTIME_STORAGE_LEASE_PATH";
+    const READY: &str = "CODEX_RUNTIME_STORAGE_LEASE_READY";
+
+    if std::env::var_os(CHILD).is_some() {
+        let path = PathBuf::from(std::env::var_os(PATH).expect("child rollout path"));
+        let ready = PathBuf::from(std::env::var_os(READY).expect("child ready path"));
+        let _lease = RolloutLease::acquire_for_path(&path).expect("child lease");
+        std::fs::write(ready, b"ready\n").expect("publish child readiness");
+        loop {
+            thread::park_timeout(Duration::from_secs(60));
+        }
+    }
+
+    let home = TempDir::new().expect("temp home");
+    std::fs::create_dir_all(home.path().join("sessions/2026/07/17")).expect("sessions");
+    let path = rollout_path(home.path(), Uuid::now_v7());
+    let ready = home.path().join("child-ready");
+    let mut child = Command::new(std::env::current_exe().expect("current test executable"))
+        .arg("paused_subprocess_cannot_be_expired_and_death_releases_kernel_lease")
+        .arg("--nocapture")
+        .env(CHILD, "1")
+        .env(PATH, &path)
+        .env(READY, &ready)
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .expect("spawn lease owner");
+
+    for _ in 0..500 {
+        if ready.exists() {
+            break;
+        }
+        thread::sleep(Duration::from_millis(10));
+    }
+    if !ready.exists() {
+        let _ = child.kill();
+        let _ = child.wait();
+        panic!("lease subprocess did not become ready");
+    }
+
+    assert_eq!(unsafe { libc::kill(child.id() as i32, libc::SIGSTOP) }, 0);
+    thread::sleep(Duration::from_millis(100));
+    assert!(matches!(
+        RolloutLease::try_acquire_for_path(&path).expect("paused owner attempt"),
+        TryRolloutLease::Busy
+    ));
+    assert_eq!(unsafe { libc::kill(child.id() as i32, libc::SIGKILL) }, 0);
+    let _ = child.wait().expect("reap killed owner");
+    assert!(matches!(
+        RolloutLease::try_acquire_for_path(&path).expect("post-death attempt"),
+        TryRolloutLease::Acquired(_)
+    ));
+}
