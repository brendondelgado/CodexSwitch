+++ b/codex-rs/rollout/src/bundle_move_tests.rs
@@ -0,0 +1,146 @@
+use std::io::Write;
+
+use pretty_assertions::assert_eq;
+use tempfile::TempDir;
+use uuid::Uuid;
+
+use super::*;
+
+fn synthetic_bundle(home: &Path, archived: bool, thread_id: Uuid) -> PathBuf {
+    let root = if archived {
+        "archived_sessions"
+    } else {
+        "sessions"
+    };
+    let directory = home.join(root).join("2026/07/17");
+    std::fs::create_dir_all(&directory).expect("source directory");
+    let raw = directory.join(format!("rollout-2026-07-17T12-00-00-{thread_id}.jsonl"));
+    std::fs::write(
+        &raw,
+        format!(
+            "{{\"timestamp\":\"2026-07-17T12:00:00Z\",\"type\":\"session_meta\",\"payload\":{{\"id\":\"{thread_id}\",\"cwd\":\"/synthetic/project\",\"timestamp\":\"2026-07-17T12:00:00Z\"}}}}\n{{\"type\":\"event_msg\",\"payload\":{{\"type\":\"task_complete\"}}}}\n"
+        ),
+    )
+    .expect("raw");
+    let compressed = compressed_path(&raw);
+    let output = std::fs::File::create(&compressed).expect("compressed");
+    let mut encoder = zstd::stream::write::Encoder::new(output, 3).expect("encoder");
+    encoder.include_checksum(true).expect("checksum");
+    encoder
+        .write_all(&std::fs::read(&raw).expect("read raw"))
+        .expect("encode");
+    encoder.finish().expect("finish").sync_all().expect("sync");
+    let manifest = manifest::build_verified_manifest(&raw, &compressed, 3).expect("manifest");
+    manifest::install_manifest(&manifest, &compressed).expect("install manifest");
+    raw
+}
+
+fn exercise_every_move_boundary(archive_direction: bool) {
+    for moved_prefix in 0..=3 {
+        let home = TempDir::new().expect("home");
+        let thread_id = Uuid::now_v7();
+        let source = synthetic_bundle(home.path(), !archive_direction, thread_id);
+        let destination_root = if archive_direction {
