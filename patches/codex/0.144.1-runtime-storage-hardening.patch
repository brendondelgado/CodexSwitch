+
+use super::RolloutFile;
+use super::metrics;
+use super::path;
+
+#[cfg(unix)]
+use std::os::unix::fs::MetadataExt;
+#[cfg(unix)]
+use std::os::unix::fs::OpenOptionsExt;
+
+const COMPRESSION_LEVEL: i32 = 3;
+const MIN_ARCHIVED_AGE: Duration = Duration::from_secs(15 * 60);
+const PLAIN_RETIREMENT_GRACE: Duration = Duration::from_secs(24 * 60 * 60);
+const PERIODIC_INTERVAL: Duration = Duration::from_secs(5 * 60);
+const WORKER_MAX_RUNTIME: Duration = Duration::from_secs(15 * 60);
+const MAX_CONCURRENT_COMPRESSION_JOBS: usize = 2;
+
+#[derive(Default)]
+struct CompressionStats {
+    scanned: usize,
+    compressed: usize,
+    skipped: usize,
+    failed: usize,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum CompressionOutcome {
+    Compressed,
+    VerifiedDual,
+    SkippedBusy,
+    SkippedNotEligible,
+}
+
+impl CompressionOutcome {
+    fn tag(self) -> &'static str {
+        match self {
+            Self::Compressed => "compressed",
+            Self::VerifiedDual => "verified_dual",
+            Self::SkippedBusy => "skipped_busy",
+            Self::SkippedNotEligible => "skipped_not_eligible",
+        }
+    }
+}
+
+struct CompressionMeasurement {
+    outcome: CompressionOutcome,
+    source_bytes: Option<u64>,
+    compressed_bytes: Option<u64>,
+}
+
+struct PreparedTransition {
+    source_path: PathBuf,
+    source_identity: FileIdentity,
+    compressed_path: PathBuf,
+    manifest_path: PathBuf,
+    manifest: manifest::LosslessRolloutManifest,
+    lease: RolloutLease,
+}
+
+pub(super) fn spawn(codex_home: PathBuf, state_db: Option<StateDbHandle>) {
+    tracing::debug!(
+        capability = crate::RUNTIME_STORAGE_CAPABILITY,
+        "runtime-storage worker entrypoint evaluated"
+    );
+    let Some(state_db) = state_db else {
+        metrics::run("skipped_no_catalog");
+        warn!(
+            "rollout compression remains disabled for {} because no durable local catalog is available",
+            codex_home.display()
+        );
+        return;
+    };
+    let Ok(handle) = tokio::runtime::Handle::try_current() else {
+        metrics::run("skipped_no_runtime");
+        return;
+    };
+    handle.spawn(async move {
+        loop {
+            if let Err(err) = run_once(codex_home.as_path(), &state_db).await {
+                warn!(
+                    "lossless rollout compression pass failed for {}: {err}",
+                    codex_home.display()
+                );
+            }
+            tokio::time::sleep(PERIODIC_INTERVAL).await;
+        }
+    });
+}
+
+pub(super) async fn run_once(codex_home: &Path, state_db: &StateDbHandle) -> io::Result<()> {
+    let started_at = Instant::now();
+    metrics::run("started");
+    for receipt in crate::bundle_move::reconcile_pending_rollout_moves(codex_home)? {
+        if let Some(record) = receipt.manifest_record()? {
+            state_db
+                .upsert_runtime_storage_manifest(&record)
+                .await
+                .map_err(io::Error::other)?;
+        }
+        crate::bundle_move::commit_rollout_bundle_move(receipt)?;
+    }
+    let archive_root = codex_home.join(ARCHIVED_SESSIONS_SUBDIR);
+    require_real_root(codex_home, archive_root.as_path())?;
+    let mut stats = CompressionStats::default();
+    let mut stack = vec![archive_root];
+    let mut jobs = tokio::task::JoinSet::new();
+
+    while let Some(directory) = stack.pop() {
+        if started_at.elapsed() >= WORKER_MAX_RUNTIME {
+            break;
+        }
+        let mut entries = match tokio::fs::read_dir(directory.as_path()).await {
+            Ok(entries) => entries,
+            Err(err) if err.kind() == io::ErrorKind::NotFound => continue,
+            Err(err) => return Err(err),
+        };
+        while let Some(entry) = entries.next_entry().await? {
+            if started_at.elapsed() >= WORKER_MAX_RUNTIME {
+                break;
+            }
+            let file_type = entry.file_type().await?;
+            if file_type.is_dir() {
+                stack.push(entry.path());
+                continue;
+            }
+            if !file_type.is_file() {
+                continue;
+            }
+            let Some(rollout) = RolloutFile::from_path(entry.path()) else {
+                continue;
+            };
+            if rollout.is_compressed() {
+                continue;
+            }
+            stats.scanned = stats.scanned.saturating_add(1);
+            metrics::file("scanned");
+            while jobs.len() >= MAX_CONCURRENT_COMPRESSION_JOBS {
+                collect_job(&mut jobs, &mut stats).await;
+            }
+            let path = rollout.into_path();
+            let root = codex_home.to_path_buf();
+            let state_db = state_db.clone();
+            jobs.spawn(async move { compress_and_catalog(root, path, state_db).await });
+        }
+    }
+    while !jobs.is_empty() {
+        collect_job(&mut jobs, &mut stats).await;
+    }
+    info!(
+        "lossless rollout compression pass finished: scanned={}, compressed={}, skipped={}, failed={}",
+        stats.scanned, stats.compressed, stats.skipped, stats.failed
+    );
+    metrics::run("completed");
+    metrics::run_duration("completed", started_at.elapsed());
+    Ok(())
+}
+
+async fn collect_job(
+    jobs: &mut tokio::task::JoinSet<(PathBuf, Duration, io::Result<CompressionMeasurement>)>,
+    stats: &mut CompressionStats,
+) {
+    let Some(result) = jobs.join_next().await else {
+        return;
+    };
+    match result {
+        Ok((_, duration, Ok(measurement))) => {
+            if matches!(
+                measurement.outcome,
+                CompressionOutcome::Compressed | CompressionOutcome::VerifiedDual
+            ) {
+                stats.compressed = stats.compressed.saturating_add(1);
+            } else {
+                stats.skipped = stats.skipped.saturating_add(1);
+            }
+            let tag = measurement.outcome.tag();
+            metrics::file(tag);
+            metrics::file_duration(tag, duration);
+            if let Some(bytes) = measurement.source_bytes {
+                metrics::source_bytes(tag, bytes);
+            }
+            if let Some(bytes) = measurement.compressed_bytes {
+                metrics::compressed_bytes(tag, bytes);
+                if let Some(source) = measurement.source_bytes {
+                    metrics::compression_ratio(tag, source, bytes);
+                }
+            }
+        }
+        Ok((path, duration, Err(err))) => {
+            stats.failed = stats.failed.saturating_add(1);
+            metrics::file("failed");
+            metrics::file_duration("failed", duration);
+            warn!(
+                "failed lossless rollout transition {}: {err}",
+                path.display()
+            );
+        }
+        Err(err) => {
+            stats.failed = stats.failed.saturating_add(1);
+            metrics::file("failed");
+            warn!("lossless rollout transition task failed: {err}");
+        }
+    }
+}
+
+async fn compress_and_catalog(
+    codex_home: PathBuf,
+    source_path: PathBuf,
+    state_db: StateDbHandle,
+) -> (PathBuf, Duration, io::Result<CompressionMeasurement>) {
+    let started_at = Instant::now();
+    let path_for_prepare = source_path.clone();
+    let home_for_prepare = codex_home.clone();
+    let prepared = match tokio::task::spawn_blocking(move || {
+        prepare_transition(home_for_prepare.as_path(), path_for_prepare.as_path())
+    })
+    .await
+    {
+        Ok(result) => result,
+        Err(err) => Err(io::Error::other(err)),
+    };
+    let result = match prepared {
+        Ok(PrepareResult::Finished(measurement)) => Ok(measurement),
+        Ok(PrepareResult::Prepared(prepared)) => {
+            let record = match prepared
+                .manifest
+                .to_state_record(prepared.manifest_path.as_path())
+            {
+                Ok(record) => record,
+                Err(err) => return (source_path, started_at.elapsed(), Err(err)),
+            };
+            if let Err(err) = state_db.upsert_runtime_storage_manifest(&record).await {
+                Err(io::Error::other(format!(
+                    "durable catalog commit failed; plain source retained: {err:#}"
+                )))
+            } else {
+                match state_db.runtime_storage_manifest(&record.thread_id).await {
+                    Ok(Some(committed)) if committed == record => {
+                        match tokio::task::spawn_blocking(move || finalize_transition(prepared))
+                            .await
+                        {
+                            Ok(result) => result,
+                            Err(err) => Err(io::Error::other(err)),
+                        }
+                    }
+                    Ok(_) => Err(io::Error::other(
+                        "catalog readback did not reproduce the committed generation; plain source retained",
+                    )),
+                    Err(err) => Err(io::Error::other(format!(
+                        "catalog readback failed; plain source retained: {err:#}"
+                    ))),
+                }
+            }
+        }
+        Err(err) => Err(err),
+    };
+    (source_path, started_at.elapsed(), result)
+}
+
+enum PrepareResult {
+    Finished(CompressionMeasurement),
+    Prepared(PreparedTransition),
+}
+
+fn prepare_transition(codex_home: &Path, source_path: &Path) -> io::Result<PrepareResult> {
+    let archive_root = codex_home.join(ARCHIVED_SESSIONS_SUBDIR);
+    require_beneath_real_root(archive_root.as_path(), source_path)?;
+    let lease = match RolloutLease::try_acquire_for_path(source_path)? {
+        TryRolloutLease::Acquired(lease) => lease,
+        TryRolloutLease::Busy => {
+            return Ok(PrepareResult::Finished(CompressionMeasurement {
+                outcome: CompressionOutcome::SkippedBusy,
+                source_bytes: None,
+                compressed_bytes: None,
+            }));
+        }
+    };
+    let metadata = checked_regular_metadata(source_path)?;
+    let source_bytes = metadata.len();
+    if !is_old_enough(&metadata)? || pin_path(source_path).try_exists()? {
+        return Ok(PrepareResult::Finished(CompressionMeasurement {
+            outcome: CompressionOutcome::SkippedNotEligible,
+            source_bytes: Some(source_bytes),
+            compressed_bytes: None,
+        }));
+    }
+    let source = open_source_nofollow(source_path)?;
+    let source_identity = FileIdentity::from_metadata(&source.metadata()?);
+    if !source_identity.matches_path(source_path)? {
+        return Err(io::Error::other(
+            "rollout path changed identity while opening",
+        ));
+    }
+
+    let compressed_path = path::compressed_rollout_path(source_path);
+    let manifest_path = manifest::manifest_path(compressed_path.as_path());
+    let compressed_exists = compressed_path.try_exists()?;
+    let manifest_exists = manifest_path.try_exists()?;
+    let manifest = match (compressed_exists, manifest_exists) {
+        (true, true) => {
+            let manifest = manifest::read_manifest(manifest_path.as_path())?;
+            manifest::verify_installed_representation(&manifest, compressed_path.as_path())?;
+            if manifest::digest_file(source_path)? != manifest.raw_sha256
+                || source_bytes != manifest.raw_bytes
+            {
+                return Err(io::Error::other(
+                    "plain and compressed rollout representations disagree",
+                ));
+            }
+            manifest
+        }
+        (true, false) | (false, true) => {
+            return Err(io::Error::other(
+                "ambiguous rollout transition: compressed data and manifest are incomplete",
+            ));
+        }
+        (false, false) => {
+            let parent = compressed_path
+                .parent()
+                .ok_or_else(|| io::Error::other("compressed rollout has no parent"))?;
+            let mut temp = tempfile::Builder::new()
+                .prefix("rollout-compress-")
+                .suffix(".tmp")
+                .tempfile_in(parent)?;
+            encode_deterministic_zstd(source, temp.as_file_mut())?;
+            temp.as_file_mut().flush()?;
+            temp.as_file().sync_all()?;
+            temp.as_file()
+                .set_times(FileTimes::new().set_modified(metadata.modified()?))?;
+            temp.as_file().set_permissions(metadata.permissions())?;
+            let installed = match temp.persist_noclobber(compressed_path.as_path()) {
+                Ok(file) => file,
+                Err(err) if err.error.kind() == io::ErrorKind::AlreadyExists => {
+                    return Err(io::Error::new(
+                        io::ErrorKind::AlreadyExists,
+                        "compressed rollout appeared during an exclusive transition",
+                    ));
+                }
+                Err(err) => return Err(err.error),
+            };
+            installed.sync_all()?;
+            manifest::sync_directory(parent)?;
+            if !source_identity.matches_path(source_path)? {
+                return Err(io::Error::other(
+                    "rollout path changed identity before manifest commit",
+                ));
+            }
+            let manifest = manifest::build_verified_manifest(
+                source_path,
+                compressed_path.as_path(),
+                COMPRESSION_LEVEL,
+            )?;
+            manifest::install_manifest(&manifest, compressed_path.as_path())?;
+            manifest
+        }
+    };
+
+    Ok(PrepareResult::Prepared(PreparedTransition {
+        source_path: source_path.to_path_buf(),
+        source_identity,
+        compressed_path,
+        manifest_path,
+        manifest,
+        lease,
+    }))
+}
+
+fn finalize_transition(prepared: PreparedTransition) -> io::Result<CompressionMeasurement> {
+    let PreparedTransition {
+        source_path,
+        source_identity,
+        compressed_path,
+        manifest_path,
+        manifest,
+        lease: _lease,
+    } = prepared;
+    let committed_manifest = manifest::read_manifest(manifest_path.as_path())?;
+    if committed_manifest != manifest {
+        return Err(io::Error::other(
+            "manifest generation changed before source retirement",
+        ));
+    }
+    manifest::verify_installed_representation(&manifest, compressed_path.as_path())?;
+    if pin_path(source_path.as_path()).try_exists()? {
+        return Ok(CompressionMeasurement {
+            outcome: CompressionOutcome::SkippedNotEligible,
+            source_bytes: Some(manifest.raw_bytes),
+            compressed_bytes: Some(manifest.compressed_bytes),
+        });
+    }
+    if !retirement_grace_elapsed(&manifest, SystemTime::now())? {
+        return Ok(CompressionMeasurement {
+            outcome: CompressionOutcome::VerifiedDual,
+            source_bytes: Some(manifest.raw_bytes),
+            compressed_bytes: Some(manifest.compressed_bytes),
+        });
+    }
+    if manifest::digest_file(source_path.as_path())? != manifest.raw_sha256
+        || std::fs::metadata(source_path.as_path())?.len() != manifest.raw_bytes
+        || !source_identity.matches_path(source_path.as_path())?
+    {
+        return Err(io::Error::other(
+            "source identity or bytes changed; refusing plain retirement",
+        ));
+    }
+    std::fs::remove_file(source_path.as_path())?;
+    manifest::sync_directory(
+        source_path
+            .parent()
+            .ok_or_else(|| io::Error::other("rollout source has no parent"))?,
+    )?;
+    Ok(CompressionMeasurement {
+        outcome: CompressionOutcome::Compressed,
+        source_bytes: Some(manifest.raw_bytes),
+        compressed_bytes: Some(manifest.compressed_bytes),
+    })
+}
+
+pub(super) fn retirement_grace_elapsed(
+    manifest: &manifest::LosslessRolloutManifest,
+    now: SystemTime,
+) -> io::Result<bool> {
+    let now = now
+        .duration_since(SystemTime::UNIX_EPOCH)
+        .map_err(io::Error::other)?
+        .as_secs();
+    let installed = u64::try_from(manifest.installed_at)
+        .map_err(|_| io::Error::other("manifest installed_at is negative"))?;
+    Ok(now.saturating_sub(installed) >= PLAIN_RETIREMENT_GRACE.as_secs())
+}
+
+fn encode_deterministic_zstd(mut source: File, output: impl Write) -> io::Result<()> {
+    let mut encoder = zstd::stream::write::Encoder::new(output, COMPRESSION_LEVEL)?;
+    encoder.include_checksum(true)?;
+    io::copy(&mut source, &mut encoder)?;
+    encoder.finish()?;
+    Ok(())
+}
+
+fn is_old_enough(metadata: &Metadata) -> io::Result<bool> {
+    Ok(SystemTime::now()
+        .duration_since(metadata.modified()?)
+        .unwrap_or(Duration::ZERO)
+        >= MIN_ARCHIVED_AGE)
+}
+
+fn pin_path(path: &Path) -> PathBuf {
+    let mut name = path.file_name().unwrap_or_default().to_os_string();
+    name.push(".pin");
+    path.with_file_name(name)
+}
+
+fn require_real_root(codex_home: &Path, archive_root: &Path) -> io::Result<()> {
+    let home = std::fs::symlink_metadata(codex_home)?;
+    if home.file_type().is_symlink() || !home.is_dir() {
+        return Err(io::Error::other("Codex home must be a real directory"));
+    }
+    match std::fs::symlink_metadata(archive_root) {
+        Ok(metadata) if !metadata.file_type().is_symlink() && metadata.is_dir() => Ok(()),
+        Err(err) if err.kind() == io::ErrorKind::NotFound => Ok(()),
+        _ => Err(io::Error::other(
+            "archived session root must be a real directory",
+        )),
+    }
+}
+
+fn require_beneath_real_root(root: &Path, path: &Path) -> io::Result<()> {
+    let relative = path.strip_prefix(root).map_err(|_| {
+        io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "rollout is outside the archived session root",
+        )
+    })?;
+    let mut current = root.to_path_buf();
+    let components = relative.components().collect::<Vec<_>>();
+    for component in components.iter().take(components.len().saturating_sub(1)) {
+        let Component::Normal(name) = component else {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "rollout path contains an invalid component",
+            ));
+        };
+        current.push(name);
+        let metadata = std::fs::symlink_metadata(current.as_path())?;
+        if metadata.file_type().is_symlink() || !metadata.is_dir() {
+            return Err(io::Error::other(
+                "rollout ancestor is linked or not a directory",
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn checked_regular_metadata(path: &Path) -> io::Result<Metadata> {
+    let metadata = std::fs::symlink_metadata(path)?;
+    if metadata.file_type().is_symlink() || !metadata.is_file() {
+        return Err(io::Error::other("rollout is linked or not a regular file"));
+    }
+    #[cfg(unix)]
+    if metadata.nlink() != 1 {
+        return Err(io::Error::other(
+            "rollout has an unexpected hard-link alias",
+        ));
+    }
+    Ok(metadata)
+}
+
+#[cfg(unix)]
+fn open_source_nofollow(path: &Path) -> io::Result<File> {
+    std::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path)
+}
+
+#[cfg(not(unix))]
+fn open_source_nofollow(path: &Path) -> io::Result<File> {
+    File::open(path)
+}
+
+struct FileIdentity {
+    #[cfg(unix)]
+    device: u64,
+    #[cfg(unix)]
+    inode: u64,
+    len: u64,
+    modified: Option<SystemTime>,
+    permissions: Permissions,
+}
+
+impl FileIdentity {
+    fn from_metadata(metadata: &Metadata) -> Self {
+        Self {
+            #[cfg(unix)]
+            device: metadata.dev(),
+            #[cfg(unix)]
+            inode: metadata.ino(),
+            len: metadata.len(),
+            modified: metadata.modified().ok(),
+            permissions: metadata.permissions(),
+        }
+    }
+
+    fn matches_path(&self, path: &Path) -> io::Result<bool> {
+        let metadata = checked_regular_metadata(path)?;
+        #[cfg(unix)]
+        if metadata.dev() != self.device || metadata.ino() != self.inode {
+            return Ok(false);
+        }
+        Ok(metadata.len() == self.len
+            && metadata.modified().ok() == self.modified
+            && metadata.permissions() == self.permissions)
+    }
+}
