+use std::fs::OpenOptions;
+use std::io::Write;
+
+use pretty_assertions::assert_eq;
+use tempfile::TempDir;
+use uuid::Uuid;
+
+use super::*;
+
+fn synthetic_rollout(home: &Path, thread_id: Uuid) -> PathBuf {
+    let dir = home.join("archived_sessions/2026/07/17");
+    std::fs::create_dir_all(&dir).expect("archive dir");
+    let path = dir.join(format!("rollout-2026-07-17T12-00-00-{thread_id}.jsonl"));
+    std::fs::write(
+        &path,
+        format!(
+            "{{\"timestamp\":\"2026-07-17T12:00:00Z\",\"type\":\"session_meta\",\"payload\":{{\"id\":\"{thread_id}\",\"cwd\":\"/synthetic/project\",\"timestamp\":\"2026-07-17T12:00:00Z\"}}}}\n{{\"type\":\"event_msg\",\"payload\":{{\"type\":\"task_complete\"}}}}\n"
+        ),
+    )
+    .expect("rollout");
+    path
+}
+
+fn compress(raw: &Path) -> PathBuf {
+    let compressed = raw.with_extension("jsonl.zst");
+    let output = File::create(&compressed).expect("compressed");
+    let mut encoder = zstd::stream::write::Encoder::new(output, 3).expect("encoder");
+    encoder.include_checksum(true).expect("checksum");
+    encoder
+        .write_all(&std::fs::read(raw).expect("raw"))
+        .expect("encode");
+    encoder.finish().expect("finish").sync_all().expect("sync");
+    compressed
+}
+
+#[test]
+fn manifest_round_trip_verifies_exact_decoded_bytes() {
+    let home = TempDir::new().expect("temp home");
+    let raw = synthetic_rollout(home.path(), Uuid::now_v7());
+    let compressed = compress(&raw);
+    let manifest = build_verified_manifest(&raw, &compressed, 3).expect("manifest");
+    let path = install_manifest(&manifest, &compressed).expect("install manifest");
+    assert_eq!(read_manifest(&path).expect("read manifest"), manifest);
+    verify_installed_representation(&manifest, &compressed).expect("verify representation");
+}
+
+#[test]
+fn corrupt_compressed_bytes_fail_restore_verification() {
+    let home = TempDir::new().expect("temp home");
+    let raw = synthetic_rollout(home.path(), Uuid::now_v7());
+    let compressed = compress(&raw);
+    let manifest = build_verified_manifest(&raw, &compressed, 3).expect("manifest");
+    OpenOptions::new()
+        .append(true)
+        .open(&compressed)
+        .expect("open compressed")
+        .write_all(b"corruption")
+        .expect("corrupt");
+    assert!(verify_installed_representation(&manifest, &compressed).is_err());
+}
+
+#[test]
+fn unknown_future_manifest_version_is_read_opaque_and_never_accepted() {
+    let home = TempDir::new().expect("temp home");
+    let raw = synthetic_rollout(home.path(), Uuid::now_v7());
+    let compressed = compress(&raw);
+    let manifest = build_verified_manifest(&raw, &compressed, 3).expect("manifest");
+    let path = install_manifest(&manifest, &compressed).expect("install manifest");
+    let mut value: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(&path).expect("manifest bytes")).expect("json");
+    value["schema_version"] = serde_json::Value::from(999_u64);
+    std::fs::write(&path, serde_json::to_vec(&value).expect("future json"))
+        .expect("write future manifest");
+    assert!(read_manifest(&path).is_err());
+}
