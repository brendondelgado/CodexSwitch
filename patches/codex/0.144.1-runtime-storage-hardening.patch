+#[cfg(unix)]
+#[test]
+fn symlinked_lease_root_and_hardlinked_lease_fail_closed() {
+    use std::os::unix::fs::symlink;
+
+    let home = TempDir::new().expect("temp home");
+    let external = TempDir::new().expect("external");
+    std::fs::create_dir_all(home.path().join("sessions/2026/07/17")).expect("sessions");
+    symlink(external.path(), home.path().join(".tmp")).expect("symlink root");
+    let path = rollout_path(home.path(), Uuid::now_v7());
+    assert!(RolloutLease::acquire_for_path(path.as_path()).is_err());
+
+    std::fs::remove_file(home.path().join(".tmp")).expect("remove symlink");
+    let thread_id = Uuid::now_v7();
+    let path = rollout_path(home.path(), thread_id);
+    let lease = RolloutLease::acquire_for_path(path.as_path()).expect("seed lease");
+    let lease_path = lease.path().to_path_buf();
+    drop(lease);
+    std::fs::hard_link(&lease_path, lease_path.with_extension("alias")).expect("hard link");
+    assert!(RolloutLease::acquire_for_path(path.as_path()).is_err());
+}
