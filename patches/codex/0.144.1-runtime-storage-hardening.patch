+#[test]
+fn canonical_v4_and_v7_names_map_to_private_lease_files() {
+    let home = TempDir::new().expect("temp home");
+    std::fs::create_dir_all(home.path().join("sessions/2026/07/17")).expect("sessions");
+    for thread_id in [Uuid::new_v4(), Uuid::now_v7()] {
+        let path = rollout_path(home.path(), thread_id);
+        let lease = RolloutLease::acquire_for_path(path.as_path()).expect("lease");
+        assert_eq!(
+            lease.path(),
+            home.path()
+                .join(".tmp/rollout-leases")
+                .join(format!("{thread_id}.lock"))
