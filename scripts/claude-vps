#!/usr/bin/env zsh
set -e

REMOTE_BACKEND_MODE="${CLAUDE_VPS_BACKEND_MODE:-native}"
REMOTE_SESSION_SLOT=""
if [ "${1:-}" = "clodex" ]; then
  REMOTE_BACKEND_MODE="clodex"
  shift
elif [ "${1:-}" = "2" ] || [ "${1:-}" = "3" ]; then
  REMOTE_SESSION_SLOT="$1"
  shift
fi
case "$REMOTE_BACKEND_MODE" in
  native|ccs|clodex) ;;
  *)
    print -u2 -- "claude-vps: unsupported CLAUDE_VPS_BACKEND_MODE: ${REMOTE_BACKEND_MODE}"
    exit 64
    ;;
esac
if [ -n "$REMOTE_SESSION_SLOT" ] && [ "$REMOTE_BACKEND_MODE" != "native" ]; then
  print -u2 -- "claude-vps: numbered sessions are available only for native Claude"
  exit 64
fi

REMOTE_HOST="${CLAUDE_VPS_REMOTE_HOST:-signul-vps}"
TAILSCALE_HOST="${CLAUDE_VPS_TAILSCALE_HOST:-signul-hostinger-kvm4}"
TAILSCALE_TARGET="${CLAUDE_VPS_TAILSCALE_TARGET:-signul@${TAILSCALE_HOST}}"
TAILSCALE_TARGET_IP="${CLAUDE_VPS_TAILSCALE_TARGET_IP:-100.95.84.123}"
TAILSCALE_BIN="${CLAUDE_VPS_TAILSCALE_BIN:-/Applications/Tailscale.app/Contents/MacOS/Tailscale}"
MOSH_BIN="${CLAUDE_VPS_MOSH_BIN:-mosh}"
MOSH_PREDICT="${CLAUDE_VPS_MOSH_PREDICT:-never}"
CMUX_BIN="${CMUX_BUNDLED_CLI_PATH:-/Applications/cmux.app/Contents/Resources/bin/cmux}"
CMUX_MANAGED_SSH_REQUESTED="${CLAUDE_VPS_CMUX_MANAGED_SSH:-auto}"
if [ "$REMOTE_BACKEND_MODE" = "clodex" ]; then
  SESSION_TRANSPORT_REQUESTED="${CLODEX_VPS_TRANSPORT:-ssh}"
else
  SESSION_TRANSPORT_REQUESTED="${CLAUDE_VPS_TRANSPORT:-auto}"
fi
REMOTE_REPO="${CLAUDE_VPS_REMOTE_REPO:-/home/signul/SIGNUL}"
CLAUDE_VPS_DEFAULT_PREFERRED_SESSION_TITLE="${CLAUDE_VPS_PREFERRED_SESSION_TITLE-backend agent}"
if [ "$REMOTE_BACKEND_MODE" = "clodex" ]; then
  REMOTE_PREFERRED_SESSION_TITLE="${CLODEX_VPS_PREFERRED_SESSION_TITLE-${CLAUDE_VPS_DEFAULT_PREFERRED_SESSION_TITLE}}"
  REMOTE_CLAUDE="${CLODEX_VPS_REMOTE_CLODEX:-/home/signul/.local/bin/clodex}"
  REMOTE_CLAUDE_SUBCOMMAND="claude"
  REMOTE_CLODEX_CREDENTIAL_HELPER="${CLODEX_VPS_CREDENTIAL_HELPER:-/home/signul/.local/bin/clodex-credential-helper}"
  REMOTE_CLODEX_CCS_RUNTIME_HELPER="${CLODEX_VPS_CCS_RUNTIME_HELPER:-/home/signul/.local/bin/clodex-ccs-runtime-helper}"
  REMOTE_CLODEX_CONFIGURATOR="${CLODEX_VPS_CONFIGURATOR:-/home/signul/.local/bin/configure-clodex-codexswitch}"
  REMOTE_CLODEX_PATCHER="${CLODEX_VPS_PATCHER:-/home/signul/.local/bin/patch-clodex-codexswitch}"
  REMOTE_CLODEX_PACKAGE_ROOT="${CLODEX_VPS_PACKAGE_ROOT:-/home/signul/.local/lib/node_modules/@bman654/clodex}"
  REMOTE_CLODEX_ISOLATED_BIN_DIR="${CLODEX_VPS_ISOLATED_BIN_DIR:-/home/signul/.local/share/clodex-codexswitch/bin}"
  REMOTE_CLODEX_ISOLATED_CLAUDE="${CLODEX_VPS_ISOLATED_CLAUDE:-/home/signul/.local/share/clodex-codexswitch/bin/claude}"
  REMOTE_CLODEX_ANTHROPIC_BACKEND="${CLODEX_VPS_ANTHROPIC_BACKEND:-ccs}"
  REMOTE_CLODEX_CCS_BASE_URL="${CLODEX_VPS_CCS_BASE_URL:-http://127.0.0.1:8317}"
elif [ -n "${CLAUDE_VPS_REMOTE_CLAUDE:-}" ]; then
  REMOTE_PREFERRED_SESSION_TITLE="$CLAUDE_VPS_DEFAULT_PREFERRED_SESSION_TITLE"
  REMOTE_CLAUDE="$CLAUDE_VPS_REMOTE_CLAUDE"
  REMOTE_CLAUDE_SUBCOMMAND="${CLAUDE_VPS_REMOTE_CLAUDE_SUBCOMMAND:-}"
  REMOTE_CLODEX_CREDENTIAL_HELPER=""
  REMOTE_CLODEX_CCS_RUNTIME_HELPER=""
  REMOTE_CLODEX_CONFIGURATOR=""
  REMOTE_CLODEX_PATCHER=""
  REMOTE_CLODEX_PACKAGE_ROOT=""
  REMOTE_CLODEX_ISOLATED_BIN_DIR=""
  REMOTE_CLODEX_ISOLATED_CLAUDE=""
  REMOTE_CLODEX_ANTHROPIC_BACKEND=""
  REMOTE_CLODEX_CCS_BASE_URL=""
elif [ "$REMOTE_BACKEND_MODE" = "ccs" ]; then
  REMOTE_PREFERRED_SESSION_TITLE="$CLAUDE_VPS_DEFAULT_PREFERRED_SESSION_TITLE"
  REMOTE_CLAUDE="/usr/bin/ccs"
  REMOTE_CLAUDE_SUBCOMMAND="${CLAUDE_VPS_REMOTE_CLAUDE_SUBCOMMAND:-claude}"
  REMOTE_CLODEX_CREDENTIAL_HELPER=""
  REMOTE_CLODEX_CCS_RUNTIME_HELPER=""
  REMOTE_CLODEX_CONFIGURATOR=""
  REMOTE_CLODEX_PATCHER=""
  REMOTE_CLODEX_PACKAGE_ROOT=""
  REMOTE_CLODEX_ISOLATED_BIN_DIR=""
  REMOTE_CLODEX_ISOLATED_CLAUDE=""
  REMOTE_CLODEX_ANTHROPIC_BACKEND=""
  REMOTE_CLODEX_CCS_BASE_URL=""
else
  REMOTE_PREFERRED_SESSION_TITLE="$CLAUDE_VPS_DEFAULT_PREFERRED_SESSION_TITLE"
  REMOTE_CLAUDE="/home/signul/.local/bin/claude"
  REMOTE_CLAUDE_SUBCOMMAND=""
  REMOTE_CLODEX_CREDENTIAL_HELPER=""
  REMOTE_CLODEX_CCS_RUNTIME_HELPER=""
  REMOTE_CLODEX_CONFIGURATOR=""
  REMOTE_CLODEX_PATCHER=""
  REMOTE_CLODEX_PACKAGE_ROOT=""
  REMOTE_CLODEX_ISOLATED_BIN_DIR=""
  REMOTE_CLODEX_ISOLATED_CLAUDE=""
  REMOTE_CLODEX_ANTHROPIC_BACKEND=""
  REMOTE_CLODEX_CCS_BASE_URL=""
fi
if [ "$REMOTE_BACKEND_MODE" = "clodex" ]; then
  case "$REMOTE_CLODEX_ANTHROPIC_BACKEND" in
    ccs|native) ;;
    *)
      print -u2 -- \
        "claude-vps: unsupported CLODEX_VPS_ANTHROPIC_BACKEND: ${REMOTE_CLODEX_ANTHROPIC_BACKEND}"
      exit 64
      ;;
  esac
fi
REMOTE_TERM="${CLAUDE_VPS_REMOTE_TERM:-xterm-256color}"
REMOTE_COLORTERM="${CLAUDE_VPS_REMOTE_COLORTERM:-truecolor}"
REMOTE_FORCE_COLOR="${CLAUDE_VPS_FORCE_COLOR:-3}"
if [ -n "$REMOTE_SESSION_SLOT" ]; then
  REMOTE_AUTO_CONTINUE="${CLAUDE_VPS_AUTO_CONTINUE:-0}"
else
  REMOTE_AUTO_CONTINUE="${CLAUDE_VPS_AUTO_CONTINUE:-1}"
fi
REMOTE_CONTROL_DEFAULT="${CLAUDE_VPS_REMOTE_CONTROL_DEFAULT:-0}"
REMOTE_CONTROL_NAME="${CLAUDE_VPS_REMOTE_CONTROL_NAME:-signul-vps}"
REMOTE_CONTROL_SPAWN="${CLAUDE_VPS_REMOTE_CONTROL_SPAWN:-same-dir}"
REMOTE_DISABLE_TMUX="${CLAUDE_VPS_DISABLE_TMUX:-0}"
if [ "$REMOTE_BACKEND_MODE" = "clodex" ]; then
  REMOTE_DANGEROUSLY_SKIP_PERMISSIONS="${CLODEX_VPS_DANGEROUSLY_SKIP_PERMISSIONS:-1}"
  REMOTE_TMUX_SESSION="${CLODEX_VPS_TMUX_SESSION:-claude-vps-clodex}"
elif [ "$REMOTE_BACKEND_MODE" = "ccs" ]; then
  REMOTE_DANGEROUSLY_SKIP_PERMISSIONS="${CLAUDE_VPS_DANGEROUSLY_SKIP_PERMISSIONS:-1}"
  REMOTE_TMUX_SESSION="${CLAUDE_VPS_TMUX_SESSION:-claude-vps-ccs}"
else
  REMOTE_DANGEROUSLY_SKIP_PERMISSIONS="${CLAUDE_VPS_DANGEROUSLY_SKIP_PERMISSIONS:-1}"
  if [ -n "$REMOTE_SESSION_SLOT" ]; then
    REMOTE_TMUX_SESSION="${CLAUDE_VPS_TMUX_SESSION:-claude-vps-${REMOTE_SESSION_SLOT}}"
  else
    REMOTE_TMUX_SESSION="${CLAUDE_VPS_TMUX_SESSION:-claude-vps}"
  fi
fi
REMOTE_TMUX_HISTORY_LIMIT="${CLAUDE_VPS_TMUX_HISTORY_LIMIT:-200000}"
REMOTE_TMUX_TERM="${CLAUDE_VPS_TMUX_TERM:-tmux-256color}"
REMOTE_TMUX_DETACH_OTHER_CLIENTS="${CLAUDE_VPS_TMUX_DETACH_OTHER_CLIENTS:-1}"
REMOTE_TMUX_LOG="${CLAUDE_VPS_TMUX_LOG:-0}"
REMOTE_TMUX_LOG_DIR="${CLAUDE_VPS_TMUX_LOG_DIR:-}"
REMOTE_TMUX_STATUS="${CLAUDE_VPS_TMUX_STATUS:-0}"
REMOTE_TMUX_STATUS_POSITION="${CLAUDE_VPS_TMUX_STATUS_POSITION:-top}"
REMOTE_TMUX_STATUS_INTERVAL="${CLAUDE_VPS_TMUX_STATUS_INTERVAL:-5}"
REMOTE_TMUX_FORCE_COPY_SCROLL="${CLAUDE_VPS_TMUX_FORCE_COPY_SCROLL:-0}"
REMOTE_TRANSPORT_LABEL="${CLAUDE_VPS_TRANSPORT_LABEL:-ssh}"
REMOTE_CLAUDE_NO_FLICKER="${CLAUDE_VPS_CLAUDE_CODE_NO_FLICKER:-0}"
REMOTE_CLAUDE_DISABLE_ALTERNATE_SCREEN="${CLAUDE_VPS_CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN:-0}"
REMOTE_CLAUDE_SCROLL_SPEED="${CLAUDE_VPS_CLAUDE_CODE_SCROLL_SPEED:-3}"
REMOTE_CLAUDE_DISABLE_MOUSE="${CLAUDE_VPS_CLAUDE_CODE_DISABLE_MOUSE:-0}"
REMOTE_CLAUDE_DISABLE_VIRTUAL_SCROLL="${CLAUDE_VPS_CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL:-0}"
REMOTE_CLAUDE_STATUSLINE="${CLAUDE_VPS_CLAUDE_STATUSLINE:-1}"
SSH_CONNECT_TIMEOUT="${CLAUDE_VPS_CONNECT_TIMEOUT:-8}"
SSH_SERVER_ALIVE_INTERVAL="${CLAUDE_VPS_SERVER_ALIVE_INTERVAL:-30}"
SSH_SERVER_ALIVE_COUNT_MAX="${CLAUDE_VPS_SERVER_ALIVE_COUNT_MAX:-6}"
SSH_AUTO_RECONNECT="${CLAUDE_VPS_AUTO_RECONNECT:-1}"
SSH_RECONNECT_DELAY="${CLAUDE_VPS_RECONNECT_DELAY:-2}"
SSH_RECONNECT_MAX="${CLAUDE_VPS_RECONNECT_MAX:-0}"
SYNC_DESKTOP_SESSION_INDEX="${CLAUDE_VPS_SYNC_DESKTOP_SESSION_INDEX:-0}"
DESKTOP_SESSION_ROOT="${CLAUDE_VPS_DESKTOP_SESSION_ROOT:-$HOME/Library/Application Support/Claude/claude-code-sessions}"
REMOTE_RESPAWN_PANE="${CLAUDE_VPS_RESPAWN_PANE:-0}"

SSH_OPTS=(
  -o BatchMode=yes
  -o "ConnectTimeout=${SSH_CONNECT_TIMEOUT}"
  -o "ServerAliveInterval=${SSH_SERVER_ALIVE_INTERVAL}"
  -o "ServerAliveCountMax=${SSH_SERVER_ALIVE_COUNT_MAX}"
  -o ControlMaster=no
  -o ControlPath=none
  -o ControlPersist=no
)
SSH_PROXY_OPTS=(
  "${SSH_OPTS[@]}"
  -o StrictHostKeyChecking=accept-new
  -o "ProxyCommand=${TAILSCALE_BIN} nc %h %p"
)

log() {
  echo "claude-vps: $*" >&2
}

quote_zsh() {
  printf '%q' "$1"
}

use_cmux_managed_ssh() {
  case "$CMUX_MANAGED_SSH_REQUESTED" in
    1|true|yes|on) ;;
    0|false|no|off) return 1 ;;
    auto)
      [ -n "${CMUX_WORKSPACE_ID:-}" ] || return 1
      ;;
    *)
      log "unsupported CLAUDE_VPS_CMUX_MANAGED_SSH=${CMUX_MANAGED_SSH_REQUESTED}"
      return 1
      ;;
  esac
  [ -x "$CMUX_BIN" ] || return 1
  [ "$REMOTE_DISABLE_TMUX" != "1" ] || return 1
  [ "$#" -eq 0 ] || return 1
}

launch_cmux_managed_ssh() {
  local existing_workspace
  local -a cmux_args
  existing_workspace="$(
    CMUX_QUIET=1 "$CMUX_BIN" workspace list 2>/dev/null |
      awk -v name="$REMOTE_TMUX_SESSION" \
        '$2 == name && $0 ~ /\[ssh:/ { print $1; exit }'
  )"
  if [ -n "$existing_workspace" ]; then
    log "selecting existing cmux managed SSH workspace ${REMOTE_TMUX_SESSION}"
    exec env CMUX_QUIET=1 "$CMUX_BIN" select-workspace --workspace "$existing_workspace"
  fi

  log "opening cmux managed SSH workspace ${REMOTE_TMUX_SESSION} (SCP image uploads enabled)"
  cmux_args=(
    ssh "$REMOTE_HOST"
    --name "$REMOTE_TMUX_SESSION"
    --ssh-option RequestTTY=force
  )
  case "${CLAUDE_VPS_CMUX_NO_FOCUS:-0}" in
    1|true|yes|on) cmux_args+=(--no-focus) ;;
  esac
  cmux_args+=(-- /usr/bin/tmux attach-session -d -t "$REMOTE_TMUX_SESSION")
  exec env CMUX_QUIET=1 "$CMUX_BIN" "${cmux_args[@]}"
}

terminal_size() {
  local size rows cols
  size="$(stty size 2>/dev/null || true)"
  rows="${size%% *}"
  cols="${size##* }"

  if [[ ! "$rows" =~ '^[1-9][0-9]*$' ]]; then
    rows="${LINES:-24}"
  fi
  if [[ ! "$cols" =~ '^[1-9][0-9]*$' ]]; then
    cols="${COLUMNS:-80}"
  fi
  if [[ ! "$rows" =~ '^[1-9][0-9]*$' ]]; then
    rows=24
  fi
  if [[ ! "$cols" =~ '^[1-9][0-9]*$' ]]; then
    cols=80
  fi

  printf '%s %s\n' "$rows" "$cols"
}

remote_env_prefix() {
  local size rows cols continue_arg
  size="$(terminal_size)"
  rows="${size%% *}"
  cols="${size##* }"
  continue_arg=""
  if [ "$REMOTE_AUTO_CONTINUE" = "1" ]; then
    continue_arg="--continue"
  fi
  printf 'REMOTE_REPO=%s CLAUDE_VPS_BACKEND_MODE=%s CLAUDE_VPS_PREFERRED_SESSION_TITLE=%s REMOTE_CLAUDE=%s REMOTE_CLAUDE_SUBCOMMAND=%s CLODEX_CREDENTIAL_HELPER=%s CLODEX_CCS_RUNTIME_HELPER=%s CLODEX_CODEXSWITCH_CONFIGURATOR=%s CLODEX_CODEXSWITCH_PATCHER=%s CLODEX_CODEXSWITCH_PACKAGE_ROOT=%s CLODEX_ISOLATED_BIN_DIR=%s TWEAKCC_CC_INSTALLATION_PATH=%s CLODEX_ANTHROPIC_BACKEND=%s CLODEX_CCS_BASE_URL=%s TERM=%s COLORTERM=%s REMOTE_COLORTERM=%s FORCE_COLOR=%s REMOTE_FORCE_COLOR=%s CLAUDE_CODE_NO_FLICKER=%s CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=%s CLAUDE_CODE_SCROLL_SPEED=%s CLAUDE_CODE_DISABLE_MOUSE=%s CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL=%s CLAUDE_VPS_CLAUDE_STATUSLINE=%s CLAUDE_VPS_AUTO_CONTINUE=%s REMOTE_AUTO_CONTINUE=%s CLAUDE_VPS_CONTINUE_ARG=%s CLAUDE_VPS_REMOTE_CONTROL_DEFAULT=%s CLAUDE_VPS_REMOTE_CONTROL_NAME=%s CLAUDE_VPS_REMOTE_CONTROL_SPAWN=%s CODEXSWITCH_REMOTE_TTY_ROWS=%s CODEXSWITCH_REMOTE_TTY_COLS=%s CLAUDE_VPS_DISABLE_TMUX=%s CLAUDE_VPS_DANGEROUSLY_SKIP_PERMISSIONS=%s CLAUDE_VPS_TMUX_SESSION=%s CLAUDE_VPS_TMUX_HISTORY_LIMIT=%s CLAUDE_VPS_TMUX_TERM=%s CLAUDE_VPS_TMUX_DETACH_OTHER_CLIENTS=%s CLAUDE_VPS_TMUX_LOG=%s CLAUDE_VPS_TMUX_LOG_DIR=%s CLAUDE_VPS_TMUX_STATUS=%s CLAUDE_VPS_TMUX_STATUS_POSITION=%s CLAUDE_VPS_TMUX_STATUS_INTERVAL=%s CLAUDE_VPS_TMUX_FORCE_COPY_SCROLL=%s CLAUDE_VPS_RESPAWN_PANE=%s CLAUDE_VPS_TRANSPORT_LABEL=%s' \
    "$(quote_zsh "$REMOTE_REPO")" \
