    "$(quote_zsh "$REMOTE_RESPAWN_PANE")" \
    "$(quote_zsh "$REMOTE_TRANSPORT_LABEL")"
}

select_ssh_transport() {
  selected_host="$REMOTE_HOST"
  selected_ssh_opts=("${SSH_OPTS[@]}")

  if [ "${CLAUDE_VPS_DISABLE_TAILSCALE_PROXY:-0}" = "1" ]; then
    return
  fi
  if [ "$REMOTE_HOST" != "signul-vps" ]; then
    return
  fi
  if [ ! -x "$TAILSCALE_BIN" ]; then
    return
  fi

  selected_host="$TAILSCALE_TARGET"
  selected_ssh_opts=("${SSH_PROXY_OPTS[@]}")
}

mosh_ssh_command() {
  local parts quoted part
  parts=("ssh" "${selected_ssh_opts[@]}")
  quoted=()
  for part in "${parts[@]}"; do
    quoted+=("$(quote_zsh "$part")")
  done
  printf '%s ' "${quoted[@]}"
}

tailscale_packet_filter_allows_mosh() {
  if [ ! -x "$TAILSCALE_BIN" ] || ! command -v jq >/dev/null 2>&1; then
    return 1
  fi

  "$TAILSCALE_BIN" debug netmap 2>/dev/null | jq -e --arg ip "$TAILSCALE_TARGET_IP" '
    any(.PacketFilterRules[]?.DstPorts[]?;
      .IP == $ip and
      (.Ports.First <= 60000) and
      (.Ports.Last >= 61000)
    )
  ' >/dev/null 2>&1
}

select_session_transport() {
  selected_session_transport="ssh"

  if [ "$#" -ne 0 ] || [ "$REMOTE_DISABLE_TMUX" = "1" ]; then
    return
  fi

  case "$SESSION_TRANSPORT_REQUESTED" in
    ssh)
      return
      ;;
    mosh)
      if ! command -v "$MOSH_BIN" >/dev/null 2>&1; then
        log "mosh requested but '${MOSH_BIN}' is not installed or not on PATH; using ssh."
        return
      fi
      selected_session_transport="mosh"
      return
      ;;
    auto)
      if command -v "$MOSH_BIN" >/dev/null 2>&1 && tailscale_packet_filter_allows_mosh; then
        selected_session_transport="mosh"
      fi
      return
      ;;
    *)
      log "unknown CLAUDE_VPS_TRANSPORT='${SESSION_TRANSPORT_REQUESTED}'; using ssh."
      return
      ;;
  esac
}

remote_session_snapshot_script() {
  cat <<'REMOTE_SCRIPT'
python3 - <<'PY'
import glob
import json
import os
import sys

repo = os.environ.get("REMOTE_REPO", "")
if not repo:
    sys.exit(0)
project_key = repo.replace("/", "-")
project_dir = os.path.expanduser(os.path.join("~", ".claude", "projects", project_key))
paths = glob.glob(os.path.join(project_dir, "*.jsonl"))
if not paths:
    sys.exit(0)
path = max(paths, key=os.path.getmtime)
session_id = os.path.basename(path)[:-len(".jsonl")]
stat = os.stat(path)
title = ""
model = ""
effort = ""
window = 16 * 1024 * 1024

with open(path, "rb") as handle:
    if stat.st_size > window:
        handle.seek(stat.st_size - window)
        handle.readline()
    for raw_line in handle:
        try:
            event = json.loads(raw_line)
        except Exception:
            continue
        if event.get("type") == "custom-title" and event.get("customTitle"):
            title = event["customTitle"]
        if event.get("model"):
            model = event["model"]
        effort_value = event.get("effort")
        if isinstance(effort_value, dict) and effort_value.get("level"):
            effort = effort_value["level"]
        elif isinstance(effort_value, str):
            effort = effort_value

print(json.dumps({
    "sessionId": session_id,
    "cwd": repo,
    "mtimeMs": int(stat.st_mtime * 1000),
    "title": title,
    "model": model,
    "effort": effort,
}, separators=(",", ":")))
PY
REMOTE_SCRIPT
}

refresh_claude_desktop_session_index() {
  if [ "$SYNC_DESKTOP_SESSION_INDEX" != "1" ]; then
    return
  fi
  if [ "$#" -ne 0 ] || [ "$REMOTE_DISABLE_TMUX" = "1" ]; then
    return
  fi
  if [ ! -d "$DESKTOP_SESSION_ROOT" ] || ! command -v jq >/dev/null 2>&1; then
    return
  fi

  local snapshot session_id mtime_ms title model effort session_file tmp
  snapshot="$(ssh "${selected_ssh_opts[@]}" "$selected_host" "$(remote_env_prefix) bash -lc $(quote_zsh "$(remote_session_snapshot_script)")" 2>/dev/null || true)"
  if [ -z "$snapshot" ]; then
    return
  fi
  session_id="$(printf '%s' "$snapshot" | jq -er '.sessionId // empty' 2>/dev/null || true)"
  mtime_ms="$(printf '%s' "$snapshot" | jq -er '.mtimeMs // empty' 2>/dev/null || true)"
  title="$(printf '%s' "$snapshot" | jq -er '.title // empty' 2>/dev/null || true)"
  model="$(printf '%s' "$snapshot" | jq -er '.model // empty' 2>/dev/null || true)"
  effort="$(printf '%s' "$snapshot" | jq -er '.effort // empty' 2>/dev/null || true)"
  if [ -z "$session_id" ] || [ -z "$mtime_ms" ]; then
    return
  fi

  session_file="$(find "$DESKTOP_SESSION_ROOT" -type f -name 'local_*.json' -print0 2>/dev/null | while IFS= read -r -d '' candidate; do
    if jq -e --arg session_id "$session_id" '(.cliSessionId == $session_id) or (.sessionId == ("local_" + $session_id))' "$candidate" >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      break
    fi
  done)"
  if [ -z "$session_file" ]; then
    return
  fi

  tmp="$(mktemp)"
  if jq --argjson mtime "$mtime_ms" --arg title "$title" --arg model "$model" --arg effort "$effort" '
    .lastActivityAt = $mtime |
    .lastFocusedAt = $mtime |
    .isArchived = false |
    if $title != "" then .title = $title | .titleSource = "user" else . end |
    if $model != "" then .model = $model else . end |
    if $effort != "" then .effort = $effort else . end
  ' "$session_file" > "$tmp"; then
    mv "$tmp" "$session_file"
    chmod 600 "$session_file" 2>/dev/null || true
  else
    rm -f "$tmp"
  fi
}

selected_host="$REMOTE_HOST"
selected_ssh_opts=("${SSH_OPTS[@]}")
select_ssh_transport

while [ "$#" -gt 0 ]; do
  case "${1:-}" in
    -yolo|--yolo|--dangerously-skip-permissions)
      REMOTE_DANGEROUSLY_SKIP_PERMISSIONS=1
      shift
      ;;
    --safe|--ask-permissions)
      REMOTE_DANGEROUSLY_SKIP_PERMISSIONS=0
      shift
      ;;
    --remote-control|--rc|--web)
      REMOTE_CONTROL_DEFAULT=1
      REMOTE_DISABLE_TMUX=1
      shift
      ;;
    --tmux|--persistent)
      REMOTE_CONTROL_DEFAULT=0
      REMOTE_DISABLE_TMUX=0
      shift
      ;;
    --raw|--no-tmux|--terminal|--tui)
      REMOTE_CONTROL_DEFAULT=0
      REMOTE_DISABLE_TMUX=1
      shift
      ;;
    --fullscreen)
      REMOTE_CONTROL_DEFAULT=0
      REMOTE_DISABLE_TMUX=1
      REMOTE_CLAUDE_NO_FLICKER=1
      REMOTE_CLAUDE_DISABLE_ALTERNATE_SCREEN=0
      shift
      ;;
    --classic|--native-scrollback)
      REMOTE_CONTROL_DEFAULT=0
      REMOTE_DISABLE_TMUX=1
      REMOTE_CLAUDE_NO_FLICKER=0
      REMOTE_CLAUDE_DISABLE_ALTERNATE_SCREEN=1
      shift
      ;;
    --repair-scrollback|--respawn-pane)
      REMOTE_CONTROL_DEFAULT=0
      REMOTE_DISABLE_TMUX=0
      REMOTE_RESPAWN_PANE=1
      shift
      ;;
    *)
      break
      ;;
  esac
done

if [ "${1:-}" = "--check" ]; then
  log "checking ${selected_host} Claude Code..."
  ssh "${selected_ssh_opts[@]}" "$selected_host" "$(remote_env_prefix) bash -lc 'test -x \"\$REMOTE_CLAUDE\" && if [ \"\$CLAUDE_VPS_BACKEND_MODE\" = clodex ]; then test -x \"\$CLODEX_CREDENTIAL_HELPER\" && test -x \"\$CLODEX_CODEXSWITCH_CONFIGURATOR\" && test -x \"\$CLODEX_CODEXSWITCH_PATCHER\" && test -x \"\$TWEAKCC_CC_INSTALLATION_PATH\" && \"\$CLODEX_CODEXSWITCH_PATCHER\" --check --package-root \"\$CLODEX_CODEXSWITCH_PACKAGE_ROOT\" && \"\$CLODEX_CODEXSWITCH_CONFIGURATOR\" --check --package-root \"\$CLODEX_CODEXSWITCH_PACKAGE_ROOT\" --helper \"\$CLODEX_CREDENTIAL_HELPER\" && case \"\$CLODEX_ANTHROPIC_BACKEND\" in ccs) test -x \"\$CLODEX_CCS_RUNTIME_HELPER\" && \"\$CLODEX_CCS_RUNTIME_HELPER\" --check ;; native) : ;; *) exit 78 ;; esac && clodex_dry=\"\$(PATH=\"\$CLODEX_ISOLATED_BIN_DIR:\$PATH\" \"\$REMOTE_CLAUDE\" claude --proxy --dry-run 2>&1)\" && ! printf \"%s\\n\" \"\$clodex_dry\" | grep -Eq \"not patched|stale-patched\" && printf \"%s\\n\" \"\$clodex_dry\" | grep -q \"clodex:openai-oauth:\"; fi && cd \"\$REMOTE_REPO\" && if [ -n \"\$REMOTE_CLAUDE_SUBCOMMAND\" ]; then printf \"claude-vps ready: %s %s in %s\\n\" \"\$REMOTE_CLAUDE\" \"\$REMOTE_CLAUDE_SUBCOMMAND\" \"\$PWD\" && \"\$REMOTE_CLAUDE\" \"\$REMOTE_CLAUDE_SUBCOMMAND\" --version; else printf \"claude-vps ready: %s in %s\\n\" \"\$REMOTE_CLAUDE\" \"\$PWD\" && \"\$REMOTE_CLAUDE\" --version; fi'"
  exit 0
fi

remote_args=()
for arg in "$@"; do
  remote_args+=("$(quote_zsh "$arg")")
done

selected_session_transport="ssh"
select_session_transport "$@"
if use_cmux_managed_ssh "$@"; then
  selected_session_transport="cmux-ssh"
fi
REMOTE_TRANSPORT_LABEL="$selected_session_transport"

remote_tmux_script() {
  cat <<'REMOTE_SCRIPT'
resolve_latest_repo_session_id() {
  python3 - "$REMOTE_REPO" "${CLAUDE_VPS_PREFERRED_SESSION_TITLE:-}" <<'PY'
import glob
import json
import os
import sys

repo = sys.argv[1]
preferred_title = " ".join(sys.argv[2].split()).casefold()
project_key = repo.replace("/", "-")
project_dir = os.path.expanduser(os.path.join("~", ".claude", "projects", project_key))
paths = glob.glob(os.path.join(project_dir, "*.jsonl"))
if not paths:
    if preferred_title:
        print("__CLAUDE_VPS_PREFERRED_TITLE_NOT_FOUND__")
    raise SystemExit(0)

selected_paths = paths
if preferred_title:
    selected_paths = []
    for path in paths:
        title = ""
        try:
            with open(path, "rb") as handle:
                for raw_line in handle:
                    if b"custom-title" not in raw_line:
                        continue
                    try:
                        event = json.loads(raw_line)
                    except Exception:
                        continue
                    if event.get("type") == "custom-title" and event.get("customTitle"):
                        title = " ".join(str(event["customTitle"]).split()).casefold()
        except OSError:
            continue
        if title == preferred_title:
            selected_paths.append(path)
    if not selected_paths:
        print("__CLAUDE_VPS_PREFERRED_TITLE_NOT_FOUND__")
        raise SystemExit(0)

selected = max(selected_paths, key=os.path.getmtime)
print(os.path.basename(selected)[:-len(".jsonl")])
PY
}

resolve_live_session_owner() {
  python3 - "$1" "${CLAUDE_VPS_TMUX_SESSION:-}" <<'PY'
import glob
import json
import os
import pathlib
import subprocess
import sys

session_id = sys.argv[1]
managed_session = sys.argv[2]
parents = {}
arguments = {}
starts = {}
for stat_path in glob.glob("/proc/[0-9]*/stat"):
    try:
        stat = pathlib.Path(stat_path).read_text()
        end = stat.rfind(")")
        fields = stat[end + 2 :].split()
        pid = int(stat[: stat.find(" ")])
        parents[pid] = int(fields[1])
        starts[pid] = fields[19]
        arguments[pid] = [
            value.decode("utf-8", "replace")
            for value in pathlib.Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
            if value
        ]
    except Exception:
        continue

target_pids = {
    pid
    for pid, args in arguments.items()
    if pid != os.getpid() and session_id in args
}
# Claude can switch threads after startup. Only trust a registration for this
# exact live process incarnation; a stale PID file must never redirect attach.
for registration in pathlib.Path.home().joinpath(".claude", "sessions").glob("*.json"):
    try:
        record = json.loads(registration.read_text())
        pid = int(record["pid"])
        if pid == os.getpid() or pid not in starts:
            continue
        if str(record.get("procStart", "")) != starts[pid]:
            continue
        if not record.get("sessionId"):
            continue
        target_pids.discard(pid)
        if record["sessionId"] == session_id:
            target_pids.add(pid)
    except (OSError, ValueError, KeyError, TypeError):
        continue
if not target_pids:
    print("none")
    raise SystemExit(0)

panes = {}
try:
    output = subprocess.check_output(
        ["tmux", "list-panes", "-a", "-F", "#{session_name}\t#{pane_pid}"],
        text=True,
    )
    for line in output.splitlines():
        name, pane_pid = line.split("\t", 1)
        panes[int(pane_pid)] = name
except Exception:
    panes = {}

owners = set()
external = False
for target_pid in target_pids:
    pid = target_pid
    seen = set()
    owner = None
    while pid in parents and pid not in seen:
        if pid in panes:
            owner = panes[pid]
            break
        seen.add(pid)
        pid = parents[pid]
    if owner is None:
        external = True
    else:
        owners.add(owner)

managed_owner = next(iter(owners)) if len(owners) == 1 else None
if managed_session and managed_owner and (
    managed_owner == managed_session
    or managed_owner.startswith(managed_session + "-preserved-")
):
    print("tmux:" + managed_owner)
elif external and owners or len(owners) > 1:
    print("ambiguous")
elif external:
    print("external")
elif len(owners) == 1:
    print("tmux:" + next(iter(owners)))
else:
    print("none")
PY
}

select_latest_managed_session() {
  CLAUDE_VPS_RESUME_SESSION_ID=""
  case "${CLAUDE_VPS_AUTO_CONTINUE:-1}" in
    1|true|yes|on) ;;
    *) return ;;
  esac

  latest_session_id="$(resolve_latest_repo_session_id)"
  if [ "$latest_session_id" = "__CLAUDE_VPS_PREFERRED_TITLE_NOT_FOUND__" ]; then
    printf "claude-vps: refusing fallback because the configured preferred session title was not found\n" >&2
    exit 74
  fi
  if [ -z "$latest_session_id" ]; then
    return
  fi
  case "$latest_session_id" in
    *[!A-Za-z0-9._-]*)
      printf "claude-vps: refusing invalid latest session identity\n" >&2
      exit 72
      ;;
  esac

  base_session="$CLAUDE_VPS_TMUX_SESSION"
  owner="$(resolve_live_session_owner "$latest_session_id")"
  case "$owner" in
    "tmux:$base_session"|tmux:"$base_session"-preserved-*)
      CLAUDE_VPS_TMUX_SESSION="${owner#tmux:}"
      ;;
    tmux:*)
      printf "claude-vps: refusing concurrent resume; latest session is owned by unmanaged tmux %s\n" "${owner#tmux:}" >&2
      exit 73
      ;;
    external)
      printf "claude-vps: refusing concurrent resume; latest session is owned by a non-tmux process (including a Claude background agent). Stop that exact writer at a safe handoff point before changing backends.\n" >&2
      exit 73
      ;;
    ambiguous)
      printf "claude-vps: refusing concurrent resume; latest session has ambiguous live ownership\n" >&2
      exit 73
      ;;
    none)
      CLAUDE_VPS_RESUME_SESSION_ID="$latest_session_id"
      if tmux has-session -t "$base_session" 2>/dev/null &&
        tmux list-panes -t "$base_session" -F "#{pane_dead}" 2>/dev/null | grep -q "^0$"; then
        preserved="${base_session}-preserved-$(date +%Y%m%dT%H%M%S)"
        suffix=1
        while tmux has-session -t "$preserved" 2>/dev/null; do
          preserved="${base_session}-preserved-$(date +%Y%m%dT%H%M%S)-${suffix}"
          suffix=$((suffix + 1))
        done
        tmux rename-session -t "$base_session" "$preserved"
        printf "claude-vps: preserved mismatched live pane as %s\n" "$preserved" >&2
      fi
      CLAUDE_VPS_TMUX_SESSION="$base_session"
      ;;
  esac
}

bind_resume_to_launch_command() {
  local launch_command="$1" quoted_resume_id
  printf -v quoted_resume_id '%q' "${CLAUDE_VPS_RESUME_SESSION_ID:-}"
  printf 'export CLAUDE_VPS_RESUME_SESSION_ID=%s; %s' \
    "$quoted_resume_id" \
    "$launch_command"
}

ensure_claude_vps_statusline() {
  case "${CLAUDE_VPS_CLAUDE_STATUSLINE:-1}" in
    0|off|false|no) return ;;
  esac
  if ! command -v jq >/dev/null 2>&1; then
    return
  fi

  statusline_path="$HOME/.claude/bin/claude-vps-statusline.sh"
  settings_path="$HOME/.claude/settings.json"
  mkdir -p "$HOME/.claude/bin" "$HOME/.claude" 2>/dev/null || return
  cat > "$statusline_path" <<'STATUSLINE_SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

input="$(cat)"

if ! command -v jq >/dev/null 2>&1; then
  printf 'Claude Code'
  exit 0
fi

model="$(jq -r '.model.display_name // .model.name // .model // "Claude"' <<<"$input" 2>/dev/null || printf 'Claude')"
cwd="$(jq -r '.workspace.current_dir // .cwd // ""' <<<"$input" 2>/dev/null || true)"
branch="$(jq -r '.workspace.git_branch // .git.branch // empty' <<<"$input" 2>/dev/null || true)"
context_pct="$(jq -r '.context_window.used_percentage // .context_window.current_usage // empty' <<<"$input" 2>/dev/null || true)"
cost="$(jq -r '.cost.total_cost_usd // .total_cost_usd // .session_cost_usd // empty' <<<"$input" 2>/dev/null || true)"
rate_5h="$(jq -r '.rate_limits.five_hour.used_percentage // empty' <<<"$input" 2>/dev/null || true)"

if [ -n "$cwd" ]; then
  cwd="${cwd/#$HOME/~}"
else
  cwd="$(pwd 2>/dev/null || true)"
fi

parts=()
parts+=("$model")
[ -n "$cwd" ] && parts+=("$cwd")
[ -n "$branch" ] && parts+=("git:$branch")

if [[ "$context_pct" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  parts+=("ctx:${context_pct%.*}%")
fi

if [[ "$rate_5h" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  parts+=("5h:${rate_5h%.*}%")
fi

if [[ "$cost" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  parts+=("cost:\$$(printf '%.2f' "$cost")")
fi

printf '%s' "${parts[0]}"
for part in "${parts[@]:1}"; do
  printf ' | %s' "$part"
done
STATUSLINE_SCRIPT
  chmod 755 "$statusline_path" 2>/dev/null || true

  if [ ! -s "$settings_path" ]; then
    printf '{}\n' > "$settings_path" || return
  fi
  tmp="$(mktemp)"
  if jq --arg command "$statusline_path" \
    '.statusLine = {"type":"command","command":$command,"padding":0,"refreshInterval":5}' \
    "$settings_path" > "$tmp"; then
    mv "$tmp" "$settings_path"
    chmod 600 "$settings_path" 2>/dev/null || true
  else
    rm -f "$tmp"
  fi
}

apply_claude_renderer_env() {
  case "${CLAUDE_CODE_NO_FLICKER:-0}" in
    1|true|yes|on) export CLAUDE_CODE_NO_FLICKER=1 ;;
    *) unset CLAUDE_CODE_NO_FLICKER ;;
  esac
  case "${CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN:-0}" in
    1|true|yes|on) export CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1 ;;
    *) unset CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN ;;
  esac
  case "${CLAUDE_CODE_DISABLE_MOUSE:-0}" in
    1|true|yes|on) export CLAUDE_CODE_DISABLE_MOUSE=1 ;;
    *) unset CLAUDE_CODE_DISABLE_MOUSE ;;
  esac
  case "${CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL:-0}" in
    1|true|yes|on) export CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL=1 ;;
    *) unset CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL ;;
  esac
}

check_clodex_runtime() {
  if [ "${CLAUDE_VPS_BACKEND_MODE:-native}" != "clodex" ]; then
    return
  fi
  test -x "$CLODEX_CODEXSWITCH_PATCHER"
  "$CLODEX_CODEXSWITCH_PATCHER" \
    --check \
    --package-root "$CLODEX_CODEXSWITCH_PACKAGE_ROOT" >/dev/null
  case "${CLODEX_ANTHROPIC_BACKEND:-ccs}" in
    ccs)
      test -x "$CLODEX_CCS_RUNTIME_HELPER"
      "$CLODEX_CCS_RUNTIME_HELPER" --check >/dev/null
      ;;
    native) ;;
    *) return 78 ;;
  esac
}

prepare_clodex_anthropic_backend() {
  local ccs_token
  if [ "${CLAUDE_VPS_BACKEND_MODE:-native}" != "clodex" ]; then
    return
  fi
  case "${CLODEX_ANTHROPIC_BACKEND:-ccs}" in
    ccs)
      ccs_token="$("$CLODEX_CCS_RUNTIME_HELPER" --token)" || return
      if [ -z "$ccs_token" ]; then
        return 78
      fi
      export ANTHROPIC_AUTH_TOKEN="$ccs_token"
      export CLODEX_ANTHROPIC_PASSTHROUGH_BASE_URL="$CLODEX_CCS_BASE_URL"
      unset ccs_token ANTHROPIC_API_KEY
      ;;
    native)
      unset CLODEX_ANTHROPIC_PASSTHROUGH_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY
      ;;
    *) return 78 ;;
  esac
}

check_clodex_runtime
ensure_claude_vps_statusline
cd "$REMOTE_REPO" || exit
if [ -n "$CODEXSWITCH_REMOTE_TTY_ROWS" ] && [ -n "$CODEXSWITCH_REMOTE_TTY_COLS" ]; then
  stty rows "$CODEXSWITCH_REMOTE_TTY_ROWS" cols "$CODEXSWITCH_REMOTE_TTY_COLS" 2>/dev/null || true
fi
stty -ixon -ixoff 2>/dev/null || true
if command -v tmux >/dev/null 2>&1; then
  select_latest_managed_session
  tmux set-option -gq default-terminal "$CLAUDE_VPS_TMUX_TERM" >/dev/null 2>&1 || true
  tmux set-option -gq history-limit "$CLAUDE_VPS_TMUX_HISTORY_LIMIT" >/dev/null 2>&1 || true
  tmux set-window-option -gq history-limit "$CLAUDE_VPS_TMUX_HISTORY_LIMIT" >/dev/null 2>&1 || true
  tmux set-option -gq focus-events on >/dev/null 2>&1 || true
  tmux set-option -gq escape-time 10 >/dev/null 2>&1 || true
  tmux set-option -gq extended-keys on >/dev/null 2>&1 || true
  tmux set-option -gq allow-passthrough on >/dev/null 2>&1 || true
  if [ "${CLAUDE_VPS_TMUX_FORCE_COPY_SCROLL:-0}" = "1" ]; then
    tmux bind-key -T root WheelUpPane copy-mode -e >/dev/null 2>&1 || true
    tmux bind-key -T copy-mode WheelUpPane send-keys -X -N 5 scroll-up >/dev/null 2>&1 || true
    tmux bind-key -T copy-mode WheelDownPane send-keys -X -N 5 scroll-down >/dev/null 2>&1 || true
    tmux bind-key -T copy-mode-vi WheelUpPane send-keys -X -N 5 scroll-up >/dev/null 2>&1 || true
    tmux bind-key -T copy-mode-vi WheelDownPane send-keys -X -N 5 scroll-down >/dev/null 2>&1 || true
  else
    tmux bind-key -T root WheelUpPane if-shell -F '#{||:#{pane_in_mode},#{mouse_any_flag}}' 'send-keys -M' 'copy-mode -e' >/dev/null 2>&1 || true
    tmux bind-key -T copy-mode WheelUpPane send-keys -X -N 5 scroll-up >/dev/null 2>&1 || true
    tmux bind-key -T copy-mode WheelDownPane send-keys -X -N 5 scroll-down >/dev/null 2>&1 || true
    tmux bind-key -T copy-mode-vi WheelUpPane send-keys -X -N 5 scroll-up >/dev/null 2>&1 || true
    tmux bind-key -T copy-mode-vi WheelDownPane send-keys -X -N 5 scroll-down >/dev/null 2>&1 || true
  fi
  tmux show-options -gqv terminal-features 2>/dev/null | grep -q "tmux-256color:RGB" || tmux set-option -gaq terminal-features ",tmux-256color:RGB" >/dev/null 2>&1 || true
  tmux show-options -gqv terminal-features 2>/dev/null | grep -q "xterm-256color:RGB" || tmux set-option -gaq terminal-features ",xterm-256color:RGB" >/dev/null 2>&1 || true
  tmux show-options -gqv terminal-overrides 2>/dev/null | grep -q "tmux-256color:RGB" || tmux set-option -gaq terminal-overrides ",tmux-256color:RGB" >/dev/null 2>&1 || true
  tmux show-options -gqv terminal-overrides 2>/dev/null | grep -q "xterm-256color:RGB" || tmux set-option -gaq terminal-overrides ",xterm-256color:RGB" >/dev/null 2>&1 || true
  tmux set-environment -g REMOTE_CLAUDE "$REMOTE_CLAUDE" >/dev/null 2>&1 || true
  tmux set-environment -g REMOTE_CLAUDE_SUBCOMMAND "$REMOTE_CLAUDE_SUBCOMMAND" >/dev/null 2>&1 || true
  tmux set-environment -g CLAUDE_VPS_BACKEND_MODE "$CLAUDE_VPS_BACKEND_MODE" >/dev/null 2>&1 || true
  tmux set-environment -g CLODEX_CREDENTIAL_HELPER "$CLODEX_CREDENTIAL_HELPER" >/dev/null 2>&1 || true
  tmux set-environment -g CLODEX_CCS_RUNTIME_HELPER "$CLODEX_CCS_RUNTIME_HELPER" >/dev/null 2>&1 || true
  tmux set-environment -g CLODEX_CODEXSWITCH_CONFIGURATOR "$CLODEX_CODEXSWITCH_CONFIGURATOR" >/dev/null 2>&1 || true
  tmux set-environment -g CLODEX_CODEXSWITCH_PATCHER "$CLODEX_CODEXSWITCH_PATCHER" >/dev/null 2>&1 || true
  tmux set-environment -g CLODEX_CODEXSWITCH_PACKAGE_ROOT "$CLODEX_CODEXSWITCH_PACKAGE_ROOT" >/dev/null 2>&1 || true
  tmux set-environment -g CLODEX_ISOLATED_BIN_DIR "$CLODEX_ISOLATED_BIN_DIR" >/dev/null 2>&1 || true
  tmux set-environment -g TWEAKCC_CC_INSTALLATION_PATH "$TWEAKCC_CC_INSTALLATION_PATH" >/dev/null 2>&1 || true
  tmux set-environment -g CLODEX_ANTHROPIC_BACKEND "$CLODEX_ANTHROPIC_BACKEND" >/dev/null 2>&1 || true
  tmux set-environment -g CLODEX_CCS_BASE_URL "$CLODEX_CCS_BASE_URL" >/dev/null 2>&1 || true
  tmux set-environment -g CLAUDE_VPS_TMUX_TERM "$CLAUDE_VPS_TMUX_TERM" >/dev/null 2>&1 || true
  tmux set-environment -g REMOTE_COLORTERM "$REMOTE_COLORTERM" >/dev/null 2>&1 || true
  tmux set-environment -g REMOTE_FORCE_COLOR "$REMOTE_FORCE_COLOR" >/dev/null 2>&1 || true
  tmux set-environment -g CLAUDE_CODE_NO_FLICKER "$CLAUDE_CODE_NO_FLICKER" >/dev/null 2>&1 || true
  tmux set-environment -g CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN "$CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN" >/dev/null 2>&1 || true
  tmux set-environment -g CLAUDE_CODE_SCROLL_SPEED "$CLAUDE_CODE_SCROLL_SPEED" >/dev/null 2>&1 || true
  tmux set-environment -g CLAUDE_CODE_DISABLE_MOUSE "$CLAUDE_CODE_DISABLE_MOUSE" >/dev/null 2>&1 || true
  tmux set-environment -g CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL "$CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL" >/dev/null 2>&1 || true
  tmux set-environment -g CLAUDE_VPS_AUTO_CONTINUE "$CLAUDE_VPS_AUTO_CONTINUE" >/dev/null 2>&1 || true
  tmux set-environment -g CLAUDE_VPS_CONTINUE_ARG "$CLAUDE_VPS_CONTINUE_ARG" >/dev/null 2>&1 || true
  tmux set-environment -g CLAUDE_VPS_RESUME_SESSION_ID "$CLAUDE_VPS_RESUME_SESSION_ID" >/dev/null 2>&1 || true
  tmux set-environment -g CLAUDE_VPS_DANGEROUSLY_SKIP_PERMISSIONS "$CLAUDE_VPS_DANGEROUSLY_SKIP_PERMISSIONS" >/dev/null 2>&1 || true
  tmux set-environment -g CLAUDE_VPS_TRANSPORT_LABEL "$CLAUDE_VPS_TRANSPORT_LABEL" >/dev/null 2>&1 || true

  claude_vps_launch='stty -ixon -ixoff 2>/dev/null || true; unset NO_COLOR; case "${CLAUDE_CODE_NO_FLICKER:-0}" in 1|true|yes|on) export CLAUDE_CODE_NO_FLICKER=1 ;; *) unset CLAUDE_CODE_NO_FLICKER ;; esac; case "${CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN:-0}" in 1|true|yes|on) export CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1 ;; *) unset CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN ;; esac; case "${CLAUDE_CODE_DISABLE_MOUSE:-0}" in 1|true|yes|on) export CLAUDE_CODE_DISABLE_MOUSE=1 ;; *) unset CLAUDE_CODE_DISABLE_MOUSE ;; esac; case "${CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL:-0}" in 1|true|yes|on) export CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL=1 ;; *) unset CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL ;; esac; claude_vps_permission_arg=""; case "${CLAUDE_VPS_DANGEROUSLY_SKIP_PERMISSIONS:-1}" in 1|true|yes|on) claude_vps_permission_arg="--dangerously-skip-permissions" ;; esac; claude_vps_resume_args="$CLAUDE_VPS_CONTINUE_ARG"; if [ -n "${CLAUDE_VPS_RESUME_SESSION_ID:-}" ]; then claude_vps_resume_args="--resume $CLAUDE_VPS_RESUME_SESSION_ID"; fi; claude_vps_backend_arg=""; claude_vps_path="$PATH"; if [ "${CLAUDE_VPS_BACKEND_MODE:-native}" = "clodex" ]; then claude_vps_backend_arg="--proxy"; claude_vps_path="$CLODEX_ISOLATED_BIN_DIR:$PATH"; case "${CLODEX_ANTHROPIC_BACKEND:-ccs}" in ccs) ANTHROPIC_AUTH_TOKEN="$("$CLODEX_CCS_RUNTIME_HELPER" --token)" || exit; [ -n "$ANTHROPIC_AUTH_TOKEN" ] || exit 78; export ANTHROPIC_AUTH_TOKEN; export CLODEX_ANTHROPIC_PASSTHROUGH_BASE_URL="$CLODEX_CCS_BASE_URL"; unset ANTHROPIC_API_KEY ;; native) unset CLODEX_ANTHROPIC_PASSTHROUGH_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY ;; *) exit 78 ;; esac; fi; if [ -n "$REMOTE_CLAUDE_SUBCOMMAND" ]; then exec env PATH="$claude_vps_path" TWEAKCC_CC_INSTALLATION_PATH="$TWEAKCC_CC_INSTALLATION_PATH" TERM="$CLAUDE_VPS_TMUX_TERM" COLORTERM="$REMOTE_COLORTERM" FORCE_COLOR="$REMOTE_FORCE_COLOR" CLAUDE_CODE_SCROLL_SPEED="$CLAUDE_CODE_SCROLL_SPEED" "$REMOTE_CLAUDE" "$REMOTE_CLAUDE_SUBCOMMAND" $claude_vps_backend_arg $claude_vps_permission_arg $claude_vps_resume_args; else exec env PATH="$claude_vps_path" TERM="$CLAUDE_VPS_TMUX_TERM" COLORTERM="$REMOTE_COLORTERM" FORCE_COLOR="$REMOTE_FORCE_COLOR" CLAUDE_CODE_SCROLL_SPEED="$CLAUDE_CODE_SCROLL_SPEED" "$REMOTE_CLAUDE" $claude_vps_permission_arg $claude_vps_resume_args; fi'
  claude_vps_launch="$(bind_resume_to_launch_command "$claude_vps_launch")"
  if ! tmux has-session -t "$CLAUDE_VPS_TMUX_SESSION" 2>/dev/null; then
    tmux new-session -d -s "$CLAUDE_VPS_TMUX_SESSION" -c "$REMOTE_REPO" "$claude_vps_launch"
  elif [ "${CLAUDE_VPS_RESPAWN_PANE:-0}" = "1" ]; then
    printf "claude-vps: recreating tmux session with history-limit %s\n" "$CLAUDE_VPS_TMUX_HISTORY_LIMIT" >&2
    tmux kill-session -t "$CLAUDE_VPS_TMUX_SESSION" 2>/dev/null || true
    tmux set-window-option -gq history-limit "$CLAUDE_VPS_TMUX_HISTORY_LIMIT" >/dev/null 2>&1 || true
    tmux new-session -d -s "$CLAUDE_VPS_TMUX_SESSION" -c "$REMOTE_REPO" "$claude_vps_launch"
  elif ! tmux list-panes -t "$CLAUDE_VPS_TMUX_SESSION" -F "#{pane_dead}" 2>/dev/null | grep -q "^0$"; then
    printf "claude-vps: respawning dead tmux pane\n" >&2
    dead_target="$(tmux list-panes -t "$CLAUDE_VPS_TMUX_SESSION" -F "#{pane_id}" 2>/dev/null | head -n 1)"
    if [ -n "$dead_target" ] && tmux respawn-pane -k -t "$dead_target" -c "$REMOTE_REPO" "$claude_vps_launch"; then
      :
    else
      tmux kill-session -t "$CLAUDE_VPS_TMUX_SESSION" 2>/dev/null || true
      tmux new-session -d -s "$CLAUDE_VPS_TMUX_SESSION" -c "$REMOTE_REPO" "$claude_vps_launch"
    fi
  fi

  tmux set-option -t "$CLAUDE_VPS_TMUX_SESSION" history-limit "$CLAUDE_VPS_TMUX_HISTORY_LIMIT" >/dev/null
  tmux set-window-option -t "${CLAUDE_VPS_TMUX_SESSION}:0" history-limit "$CLAUDE_VPS_TMUX_HISTORY_LIMIT" >/dev/null
  tmux set-option -t "$CLAUDE_VPS_TMUX_SESSION" mouse on >/dev/null
  case "${CLAUDE_VPS_TMUX_STATUS:-1}" in
    0|off|false|no) claude_vps_status_mode=off ;;
    *) claude_vps_status_mode=on ;;
  esac
  tmux set-option -t "$CLAUDE_VPS_TMUX_SESSION" status "$claude_vps_status_mode" >/dev/null
  case "${CLAUDE_VPS_TMUX_STATUS_POSITION:-top}" in
    bottom) claude_vps_status_position=bottom ;;
    *) claude_vps_status_position=top ;;
  esac
  tmux set-option -t "$CLAUDE_VPS_TMUX_SESSION" status-position "$claude_vps_status_position" >/dev/null
  tmux set-option -t "$CLAUDE_VPS_TMUX_SESSION" status-interval "${CLAUDE_VPS_TMUX_STATUS_INTERVAL:-5}" >/dev/null
  tmux set-option -t "$CLAUDE_VPS_TMUX_SESSION" status-style 'fg=colour250,bg=colour235' >/dev/null
  tmux set-option -t "$CLAUDE_VPS_TMUX_SESSION" status-left-length 90 >/dev/null
  tmux set-option -t "$CLAUDE_VPS_TMUX_SESSION" status-right-length 110 >/dev/null
  tmux set-option -t "$CLAUDE_VPS_TMUX_SESSION" status-left '#[fg=colour82,bold] claude-vps #[fg=colour244]#{@claude-vps-backend}/#{@claude-vps-transport} #[fg=colour250]#S ' >/dev/null
  tmux set-option -t "$CLAUDE_VPS_TMUX_SESSION" status-right '#[fg=colour244]#{pane_current_command} #[fg=colour250]%H:%M #[fg=colour244]#{client_width}x#{client_height} ' >/dev/null
  tmux set-option -t "$CLAUDE_VPS_TMUX_SESSION" @claude-vps-backend "${CLAUDE_VPS_BACKEND_MODE:-native}" >/dev/null 2>&1 || true
  tmux set-option -t "$CLAUDE_VPS_TMUX_SESSION" @claude-vps-transport "${CLAUDE_VPS_TRANSPORT_LABEL:-ssh}" >/dev/null 2>&1 || true
  tmux set-window-option -t "${CLAUDE_VPS_TMUX_SESSION}:0" alternate-screen on >/dev/null
  tmux set-window-option -t "${CLAUDE_VPS_TMUX_SESSION}:0" aggressive-resize on >/dev/null 2>&1 || true
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" TERM "$CLAUDE_VPS_TMUX_TERM" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" COLORTERM "$REMOTE_COLORTERM" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" FORCE_COLOR "$REMOTE_FORCE_COLOR" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLAUDE_CODE_NO_FLICKER "$CLAUDE_CODE_NO_FLICKER" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN "$CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLAUDE_CODE_SCROLL_SPEED "$CLAUDE_CODE_SCROLL_SPEED" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLAUDE_CODE_DISABLE_MOUSE "$CLAUDE_CODE_DISABLE_MOUSE" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL "$CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLAUDE_VPS_AUTO_CONTINUE "$CLAUDE_VPS_AUTO_CONTINUE" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLAUDE_VPS_CONTINUE_ARG "$CLAUDE_VPS_CONTINUE_ARG" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLAUDE_VPS_RESUME_SESSION_ID "$CLAUDE_VPS_RESUME_SESSION_ID" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLAUDE_VPS_DANGEROUSLY_SKIP_PERMISSIONS "$CLAUDE_VPS_DANGEROUSLY_SKIP_PERMISSIONS" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" REMOTE_CLAUDE "$REMOTE_CLAUDE" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" REMOTE_CLAUDE_SUBCOMMAND "$REMOTE_CLAUDE_SUBCOMMAND" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLAUDE_VPS_BACKEND_MODE "$CLAUDE_VPS_BACKEND_MODE" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLODEX_CREDENTIAL_HELPER "$CLODEX_CREDENTIAL_HELPER" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLODEX_CCS_RUNTIME_HELPER "$CLODEX_CCS_RUNTIME_HELPER" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLODEX_CODEXSWITCH_CONFIGURATOR "$CLODEX_CODEXSWITCH_CONFIGURATOR" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLODEX_CODEXSWITCH_PATCHER "$CLODEX_CODEXSWITCH_PATCHER" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLODEX_CODEXSWITCH_PACKAGE_ROOT "$CLODEX_CODEXSWITCH_PACKAGE_ROOT" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLODEX_ISOLATED_BIN_DIR "$CLODEX_ISOLATED_BIN_DIR" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" TWEAKCC_CC_INSTALLATION_PATH "$TWEAKCC_CC_INSTALLATION_PATH" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLODEX_ANTHROPIC_BACKEND "$CLODEX_ANTHROPIC_BACKEND" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLODEX_CCS_BASE_URL "$CLODEX_CCS_BASE_URL" >/dev/null
  tmux set-environment -t "$CLAUDE_VPS_TMUX_SESSION" CLAUDE_VPS_TRANSPORT_LABEL "$CLAUDE_VPS_TRANSPORT_LABEL" >/dev/null
  if [ "$CLAUDE_VPS_TMUX_LOG" = "1" ]; then
    log_dir="${CLAUDE_VPS_TMUX_LOG_DIR:-$HOME/.claude-vps/logs}"
    mkdir -p "$log_dir" 2>/dev/null || true
    log_file="$log_dir/claude-vps-$(date +%Y-%m-%d).ansi"
    quoted_log_file="$(printf '%q' "$log_file")"
    tmux pipe-pane -o -t "${CLAUDE_VPS_TMUX_SESSION}:0" "cat >> $quoted_log_file" >/dev/null 2>&1 || true
    tmux set-option -t "$CLAUDE_VPS_TMUX_SESSION" @claude-vps-log "$log_file" >/dev/null 2>&1 || true
  else
    tmux pipe-pane -t "${CLAUDE_VPS_TMUX_SESSION}:0" >/dev/null 2>&1 || true
    tmux set-option -u -t "$CLAUDE_VPS_TMUX_SESSION" @claude-vps-log >/dev/null 2>&1 || true
  fi
  case "${CLAUDE_VPS_BOOTSTRAP_ONLY:-0}" in
    1|true|yes|on)
      printf "claude-vps: tmux session %s is ready\n" "$CLAUDE_VPS_TMUX_SESSION" >&2
      exit 0
      ;;
  esac
  attach_flags=()
  if [ "${CLAUDE_VPS_TMUX_DETACH_OTHER_CLIENTS:-1}" = "1" ]; then
    attach_flags=(-d)
  fi
  tmux attach-session "${attach_flags[@]}" -t "$CLAUDE_VPS_TMUX_SESSION" || {
    if [ -n "$CLAUDE_VPS_RESUME_SESSION_ID" ]; then
      set -- --resume "$CLAUDE_VPS_RESUME_SESSION_ID"
    elif [ -n "$CLAUDE_VPS_CONTINUE_ARG" ]; then
      set -- "$CLAUDE_VPS_CONTINUE_ARG"
    fi
    case "${CLAUDE_VPS_DANGEROUSLY_SKIP_PERMISSIONS:-1}" in
      1|true|yes|on) set -- --dangerously-skip-permissions "$@" ;;
    esac
    unset NO_COLOR
    apply_claude_renderer_env
    prepare_clodex_anthropic_backend
    if [ -n "$REMOTE_CLAUDE_SUBCOMMAND" ]; then
      if [ "${CLAUDE_VPS_BACKEND_MODE:-native}" = "clodex" ]; then
        exec env TERM="$TERM" COLORTERM="$REMOTE_COLORTERM" FORCE_COLOR="$REMOTE_FORCE_COLOR" CLAUDE_CODE_SCROLL_SPEED="$CLAUDE_CODE_SCROLL_SPEED" "$REMOTE_CLAUDE" "$REMOTE_CLAUDE_SUBCOMMAND" --proxy "$@"
      fi
      exec env TERM="$TERM" COLORTERM="$REMOTE_COLORTERM" FORCE_COLOR="$REMOTE_FORCE_COLOR" CLAUDE_CODE_SCROLL_SPEED="$CLAUDE_CODE_SCROLL_SPEED" "$REMOTE_CLAUDE" "$REMOTE_CLAUDE_SUBCOMMAND" "$@"
    fi
    exec env TERM="$TERM" COLORTERM="$REMOTE_COLORTERM" FORCE_COLOR="$REMOTE_FORCE_COLOR" CLAUDE_CODE_SCROLL_SPEED="$CLAUDE_CODE_SCROLL_SPEED" "$REMOTE_CLAUDE" "$@"
  }
  exit 0
fi
if [ -n "${CLAUDE_VPS_RESUME_SESSION_ID:-}" ]; then
  set -- --resume "$CLAUDE_VPS_RESUME_SESSION_ID"
elif [ -n "$CLAUDE_VPS_CONTINUE_ARG" ]; then
  set -- "$CLAUDE_VPS_CONTINUE_ARG"
fi
case "${CLAUDE_VPS_DANGEROUSLY_SKIP_PERMISSIONS:-1}" in
  1|true|yes|on) set -- --dangerously-skip-permissions "$@" ;;
esac
unset NO_COLOR
apply_claude_renderer_env
prepare_clodex_anthropic_backend
if [ -n "$REMOTE_CLAUDE_SUBCOMMAND" ]; then
  if [ "${CLAUDE_VPS_BACKEND_MODE:-native}" = "clodex" ]; then
    exec env TERM="$TERM" COLORTERM="$REMOTE_COLORTERM" FORCE_COLOR="$REMOTE_FORCE_COLOR" CLAUDE_CODE_SCROLL_SPEED="$CLAUDE_CODE_SCROLL_SPEED" "$REMOTE_CLAUDE" "$REMOTE_CLAUDE_SUBCOMMAND" --proxy "$@"
  fi
  exec env TERM="$TERM" COLORTERM="$REMOTE_COLORTERM" FORCE_COLOR="$REMOTE_FORCE_COLOR" CLAUDE_CODE_SCROLL_SPEED="$CLAUDE_CODE_SCROLL_SPEED" "$REMOTE_CLAUDE" "$REMOTE_CLAUDE_SUBCOMMAND" "$@"
fi
exec env TERM="$TERM" COLORTERM="$REMOTE_COLORTERM" FORCE_COLOR="$REMOTE_FORCE_COLOR" CLAUDE_CODE_SCROLL_SPEED="$CLAUDE_CODE_SCROLL_SPEED" "$REMOTE_CLAUDE" "$@"
REMOTE_SCRIPT
}

remote_bare_script() {
  cat <<'REMOTE_SCRIPT'
apply_claude_renderer_env() {
  case "${CLAUDE_CODE_NO_FLICKER:-0}" in
    1|true|yes|on) export CLAUDE_CODE_NO_FLICKER=1 ;;
    *) unset CLAUDE_CODE_NO_FLICKER ;;
  esac
  case "${CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN:-0}" in
    1|true|yes|on) export CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1 ;;
    *) unset CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN ;;
  esac
  case "${CLAUDE_CODE_DISABLE_MOUSE:-0}" in
    1|true|yes|on) export CLAUDE_CODE_DISABLE_MOUSE=1 ;;
    *) unset CLAUDE_CODE_DISABLE_MOUSE ;;
  esac
  case "${CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL:-0}" in
    1|true|yes|on) export CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL=1 ;;
    *) unset CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL ;;
  esac
}

check_clodex_runtime() {
  if [ "${CLAUDE_VPS_BACKEND_MODE:-native}" != "clodex" ]; then
    return
  fi
  test -x "$CLODEX_CODEXSWITCH_PATCHER"
  "$CLODEX_CODEXSWITCH_PATCHER" \
    --check \
    --package-root "$CLODEX_CODEXSWITCH_PACKAGE_ROOT" >/dev/null
  case "${CLODEX_ANTHROPIC_BACKEND:-ccs}" in
    ccs)
      test -x "$CLODEX_CCS_RUNTIME_HELPER"
      "$CLODEX_CCS_RUNTIME_HELPER" --check >/dev/null
      ;;
    native) ;;
    *) return 78 ;;
  esac
}

prepare_clodex_anthropic_backend() {
  local ccs_token
  if [ "${CLAUDE_VPS_BACKEND_MODE:-native}" != "clodex" ]; then
    return
  fi
  case "${CLODEX_ANTHROPIC_BACKEND:-ccs}" in
    ccs)
      ccs_token="$("$CLODEX_CCS_RUNTIME_HELPER" --token)" || return
      if [ -z "$ccs_token" ]; then
        return 78
      fi
      export ANTHROPIC_AUTH_TOKEN="$ccs_token"
      export CLODEX_ANTHROPIC_PASSTHROUGH_BASE_URL="$CLODEX_CCS_BASE_URL"
      unset ccs_token ANTHROPIC_API_KEY
      ;;
    native)
      unset CLODEX_ANTHROPIC_PASSTHROUGH_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY
      ;;
    *) return 78 ;;
  esac
}

check_clodex_runtime
cd "$REMOTE_REPO" || exit
if [ -n "$CODEXSWITCH_REMOTE_TTY_ROWS" ] && [ -n "$CODEXSWITCH_REMOTE_TTY_COLS" ]; then
  stty rows "$CODEXSWITCH_REMOTE_TTY_ROWS" cols "$CODEXSWITCH_REMOTE_TTY_COLS" 2>/dev/null || true
fi
stty -ixon -ixoff 2>/dev/null || true
if [ "$#" -eq 0 ]; then
  case "${CLAUDE_VPS_REMOTE_CONTROL_DEFAULT:-0}" in
    1|true|yes|on)
      if [ -n "${CLAUDE_VPS_REMOTE_CONTROL_NAME:-}" ]; then
        set -- remote-control --name "$CLAUDE_VPS_REMOTE_CONTROL_NAME" --spawn="${CLAUDE_VPS_REMOTE_CONTROL_SPAWN:-same-dir}"
      else
        set -- remote-control --spawn="${CLAUDE_VPS_REMOTE_CONTROL_SPAWN:-same-dir}"
      fi
      ;;
    *)
      if [ -n "$CLAUDE_VPS_CONTINUE_ARG" ]; then
        set -- "$CLAUDE_VPS_CONTINUE_ARG"
      fi
      ;;
  esac
fi
case "${CLAUDE_VPS_DANGEROUSLY_SKIP_PERMISSIONS:-1}" in
  1|true|yes|on) set -- --dangerously-skip-permissions "$@" ;;
esac
unset NO_COLOR
apply_claude_renderer_env
prepare_clodex_anthropic_backend
if [ -n "$REMOTE_CLAUDE_SUBCOMMAND" ]; then
  if [ "${CLAUDE_VPS_BACKEND_MODE:-native}" = "clodex" ]; then
    exec env TERM="$TERM" COLORTERM="$REMOTE_COLORTERM" FORCE_COLOR="$REMOTE_FORCE_COLOR" CLAUDE_CODE_SCROLL_SPEED="$CLAUDE_CODE_SCROLL_SPEED" "$REMOTE_CLAUDE" "$REMOTE_CLAUDE_SUBCOMMAND" --proxy "$@"
  fi
  exec env TERM="$TERM" COLORTERM="$REMOTE_COLORTERM" FORCE_COLOR="$REMOTE_FORCE_COLOR" CLAUDE_CODE_SCROLL_SPEED="$CLAUDE_CODE_SCROLL_SPEED" "$REMOTE_CLAUDE" "$REMOTE_CLAUDE_SUBCOMMAND" "$@"
fi
exec env TERM="$TERM" COLORTERM="$REMOTE_COLORTERM" FORCE_COLOR="$REMOTE_FORCE_COLOR" CLAUDE_CODE_SCROLL_SPEED="$CLAUDE_CODE_SCROLL_SPEED" "$REMOTE_CLAUDE" "$@"
REMOTE_SCRIPT
}

remote_command_for_script() {
  local script="$1"
  printf '%s bash -lc %s claude-vps' "$(remote_env_prefix)" "$(quote_zsh "$script")"
}

if [ "$#" -eq 0 ] && [ "$REMOTE_DISABLE_TMUX" != "1" ]; then
  remote_command="$(remote_command_for_script "$(remote_tmux_script)")"
else
  remote_command="$(remote_command_for_script "$(remote_bare_script)")"
  remote_command="${remote_command} ${remote_args[*]}"
fi

if [ "$#" -eq 0 ] && [ "$REMOTE_DISABLE_TMUX" != "1" ]; then
  if [ "$REMOTE_BACKEND_MODE" = "clodex" ]; then
    if [[ "$REMOTE_DANGEROUSLY_SKIP_PERMISSIONS" =~ ^(1|true|yes|on)$ ]]; then
      log "connecting to Clodex-backed Claude Code on ${selected_host} in tmux session ${REMOTE_TMUX_SESSION} via ${selected_session_transport} (bypass permissions enabled)..."
    else
      log "connecting to Clodex-backed Claude Code on ${selected_host} in tmux session ${REMOTE_TMUX_SESSION} via ${selected_session_transport} (permission prompts enabled)..."
    fi
  else
    log "connecting to Claude Code on ${selected_host} in tmux session ${REMOTE_TMUX_SESSION} via ${selected_session_transport}..."
  fi
elif [ "$#" -eq 0 ] && [[ "$REMOTE_CONTROL_DEFAULT" =~ ^(1|true|yes|on)$ ]]; then
  log "connecting to Claude Code Remote Control on ${selected_host} through CCS..."
elif [ "$#" -eq 0 ]; then
  log "connecting to Claude Code on ${selected_host} with terminal renderer (no tmux)..."
else
  log "connecting to Claude Code on ${selected_host}..."
fi

refresh_claude_desktop_session_index "$@" >/dev/null 2>&1 &

if [ "$selected_session_transport" = "cmux-ssh" ]; then
  ssh "${selected_ssh_opts[@]}" "$selected_host" \
    "CLAUDE_VPS_BOOTSTRAP_ONLY=1 $remote_command"
  launch_cmux_managed_ssh
fi

if [ "$selected_session_transport" = "mosh" ]; then
  exec "$MOSH_BIN" --experimental-remote-ip=remote --predict="$MOSH_PREDICT" --ssh="$(mosh_ssh_command)" "$selected_host" -- /bin/bash -lc "$remote_command"
fi

if [ "$#" -eq 0 ] && [ "$REMOTE_DISABLE_TMUX" != "1" ] && [ "$SSH_AUTO_RECONNECT" = "1" ]; then
  reconnect_attempt=0
  while true; do
    set +e
    ssh -tt "${selected_ssh_opts[@]}" "$selected_host" "$remote_command"
    ssh_status="$?"
    set -e
    if [ "$ssh_status" -ne 255 ]; then
      exit "$ssh_status"
    fi
    reconnect_attempt=$((reconnect_attempt + 1))
    if [ "$SSH_RECONNECT_MAX" -gt 0 ] && [ "$reconnect_attempt" -gt "$SSH_RECONNECT_MAX" ]; then
      exit "$ssh_status"
    fi
    log "SSH transport dropped; reconnecting to ${REMOTE_TMUX_SESSION} in ${SSH_RECONNECT_DELAY}s (attempt ${reconnect_attempt})..."
    sleep "$SSH_RECONNECT_DELAY"
  done
fi

exec ssh -tt "${selected_ssh_opts[@]}" "$selected_host" "$remote_command"
